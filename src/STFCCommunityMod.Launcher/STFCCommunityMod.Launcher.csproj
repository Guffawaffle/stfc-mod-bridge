<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>STFCCommunityMod.Launcher</RootNamespace>
    <AssemblyName>STFCModBridge</AssemblyName>
    <AssemblyTitle>STFC Mod Bridge</AssemblyTitle>
    <FileDescription>STFC Mod Bridge</FileDescription>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\stfc-mod-bridge.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\STFCCommunityMod.Launcher.Core\STFCCommunityMod.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentIcons.Wpf" Version="2.1.333" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\stfc-mod-bridge.ico" />
    <Resource Include="..\..\assets\portfolio\stfc-mod-bridge-banner.png"
              Link="Assets\stfc-mod-bridge-banner.png" />
    <EmbeddedResource Include="..\..\providers\bundled-provider-catalog.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.ProviderCatalog.v1.json" />
    <EmbeddedResource Include="..\..\providers\guffawaffle\provider-pack.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.ProviderPacks.Guffawaffle.v1.json" />
    <EmbeddedResource Include="..\..\providers\netniv\provider-pack.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.ProviderPacks.Netniv.v1.json" />
    <EmbeddedResource Include="..\..\providers\known-windows-artifacts.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.KnownWindowsArtifacts.v1.json" />
    <EmbeddedResource Include="..\..\providers\reviewed-windows-releases.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.ReviewedWindowsReleases.v1.json" />
    <EmbeddedResource Include="..\..\docs\windows-launcher\config-schema.guffawaffle.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.Schemas.Guffawaffle.v1.json" />
    <EmbeddedResource Include="..\..\providers\netniv\configuration-schema-set.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.Schemas.Netniv.v1.json" />
    <EmbeddedResource Include="..\..\docs\windows-launcher\runtime-manifest.guffawaffle.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.RuntimeManifests.Guffawaffle.v1.json" />
    <EmbeddedResource Include="..\..\docs\windows-launcher\about-content.v1.json"
                      LogicalName="STFCCommunityMod.Launcher.AboutContent.v1.json" />
  </ItemGroup>
</Project>
