<Window x:Class="STFCCommunityMod.Launcher.ReleaseSecurityGuidanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Verification &amp; recovery guidance"
        Width="980"
        Height="720"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        automation:AutomationProperties.Name="Verification and recovery guidance window">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock FontSize="26"
                 FontWeight="SemiBold"
                 Text="Verification &amp; recovery guidance" />
      <TextBlock Margin="0,7,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="These repository-owned guides are bundled with Mod Bridge for offline use. They are read-only and selectable; no network request is made when this window opens."
                 TextWrapping="Wrap" />
    </StackPanel>

    <TabControl Grid.Row="1"
                Margin="0,18,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                automation:AutomationProperties.Name="Release security guidance topics">
      <TabItem Header="_Independent verification"
               automation:AutomationProperties.Name="Independent release verification guide">
        <TextBox x:Name="IndependentVerificationText"
                 Padding="16"
                 AcceptsReturn="True"
                 Background="{DynamicResource SurfaceMutedBrush}"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="12"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 HorizontalScrollBarVisibility="Disabled"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 automation:AutomationProperties.Name="Bundled independent release verification guidance" />
      </TabItem>
      <TabItem Header="_Compromise response"
               automation:AutomationProperties.Name="Compromise response guide">
        <TextBox x:Name="CompromiseResponseText"
                 Padding="16"
                 AcceptsReturn="True"
                 Background="{DynamicResource SurfaceMutedBrush}"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="12"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 HorizontalScrollBarVisibility="Disabled"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 automation:AutomationProperties.Name="Bundled compromise response guidance" />
      </TabItem>
    </TabControl>

    <Button Grid.Row="2"
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Style="{StaticResource UtilityActionButtonStyle}"
            Click="CloseButton_Click"
            Content="_Close"
            IsCancel="True"
            automation:AutomationProperties.Name="Close verification and recovery guidance" />
  </Grid>
</Window>
