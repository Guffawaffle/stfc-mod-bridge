<UserControl x:Class="STFCCommunityMod.Launcher.Views.SettingsView"
             x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:behaviors="clr-namespace:STFCCommunityMod.Launcher.Behaviors"
             xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:viewModels="clr-namespace:STFCCommunityMod.Launcher.ViewModels"
             xmlns:views="clr-namespace:STFCCommunityMod.Launcher.Views"
             MinWidth="0"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Focusable="False"
             automation:AutomationProperties.Name="Mod settings">
  <UserControl.Resources>
    <Style x:Key="SettingsNavigationFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-2"
                    BorderBrush="{DynamicResource FocusOuterBrush}"
                    BorderThickness="2"
                    CornerRadius="8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsSearchStyle"
           TargetType="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsNavigationButtonStyle"
           BasedOn="{StaticResource QuietButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsNavigationFocusVisual}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsNumericEditorStyle"
           BasedOn="{StaticResource SettingsSearchStyle}"
           TargetType="TextBox">
      <Setter Property="Width" Value="{StaticResource SettingsInputWidthSmall}" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MaxLength" Value="64" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding NumericInputWidth}" Value="Medium">
          <Setter Property="Width" Value="{StaticResource SettingsInputWidthMedium}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding NumericInputWidth}" Value="Large">
          <Setter Property="Width" Value="{StaticResource SettingsInputWidthLarge}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding NumericNeedsAttention}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsSliderTrackButtonStyle"
           TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="6"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="3" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsSliderThumbStyle"
           TargetType="Thumb">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse x:Name="ThumbSurface"
                     Fill="{TemplateBinding Background}"
                     Stroke="{DynamicResource WindowBackgroundBrush}"
                     StrokeThickness="2" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface" Property="StrokeThickness" Value="3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsNumericSliderStyle"
           TargetType="Slider">
      <Setter Property="Height" Value="34" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Track x:Name="PART_Track"
                     Margin="1,0"
                     IsDirectionReversed="False"
                     Maximum="{TemplateBinding Maximum}"
                     Minimum="{TemplateBinding Minimum}"
                     Orientation="Horizontal"
                     Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Background="{DynamicResource AccentBrush}"
                                Command="{x:Static Slider.DecreaseLarge}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Style="{StaticResource SettingsSliderTrackButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SettingsSliderThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Background="{DynamicResource SurfaceMutedBrush}"
                                Command="{x:Static Slider.IncreaseLarge}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Style="{StaticResource SettingsSliderTrackButtonStyle}" />
                </Track.IncreaseRepeatButton>
              </Track>
              <Border x:Name="SliderFocusBorder"
                      Margin="-3,1"
                      BorderBrush="{DynamicResource FocusOuterBrush}"
                      BorderThickness="2"
                      CornerRadius="8"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SliderFocusBorder" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsStringEditorStyle"
           BasedOn="{StaticResource SettingsSearchStyle}"
           TargetType="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MaxLength" Value="2048" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StringNeedsAttention}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NotificationDeliveryToggleStyle"
           TargetType="ToggleButton">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToggleSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource FocusOuterBrush}" />
                <Setter TargetName="ToggleSurface"
                        Property="BorderThickness"
                        Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.58" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BooleanEditorStyle"
           TargetType="CheckBox">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style>
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <Border BorderBrush="{DynamicResource FocusOuterBrush}"
                          BorderThickness="2"
                          CornerRadius="13" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="ToggleTrack"
                    Width="44"
                    Height="24"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
              <Ellipse x:Name="ToggleThumb"
                       Width="16"
                       Height="16"
                       Margin="4,0,0,0"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack"
                        Property="Background"
                        Value="{DynamicResource QuietHoverBrush}" />
                <Setter TargetName="ToggleTrack"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ToggleThumb"
                        Property="HorizontalAlignment"
                        Value="Right" />
                <Setter TargetName="ToggleThumb"
                        Property="Margin"
                        Value="0,0,4,0" />
                <Setter TargetName="ToggleThumb"
                        Property="Fill"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleTrack"
                        Property="BorderThickness"
                        Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsEnumItemStyle"
           TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="automation:AutomationProperties.Name"
              Value="{Binding Label}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface"
                        Property="Background"
                        Value="{DynamicResource QuietHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsEnumComboBoxStyle"
           TargetType="ComboBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MaxDropDownHeight" Value="260" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsEnumItemStyle}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate DataType="{x:Type viewModels:SettingsEnumOption}">
            <StackPanel>
              <TextBlock FontSize="13"
                         FontWeight="SemiBold"
                         Text="{Binding Label}" />
              <TextBlock Margin="0,3,0,0"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{Binding Help}"
                         TextWrapping="Wrap"
                         Visibility="{Binding HasHelp, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ControlSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1"
                              Width="10"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1,1 L 5,5 L 9,1"
                              Stretch="None"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.5" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ControlSurface"
                                Property="BorderBrush"
                                Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ControlSurface"
                                Property="BorderBrush"
                                Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="12,0,40,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" />

              <Border x:Name="KeyboardFocusBorder"
                      BorderBrush="{DynamicResource FocusOuterBrush}"
                      BorderThickness="2"
                      CornerRadius="8"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PlacementTarget="{Binding ElementName=DropDownToggle}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,4,0,0"
                        Padding="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                  <ScrollViewer CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="KeyboardFocusBorder"
                        Property="Visibility"
                        Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InvisibleScrollBarPageButtonStyle"
           TargetType="{x:Type primitives:RepeatButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:RepeatButton}">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsScrollBarThumbStyle"
           TargetType="{x:Type primitives:Thumb}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:Thumb}">
            <Border x:Name="ThumbSurface"
                    Width="6"
                    Margin="0,2"
                    HorizontalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="3" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Width"
                        Value="8" />
                <Setter Property="Background"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Width"
                        Value="8" />
                <Setter Property="Background"
                        Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsScrollBarStyle"
           TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}">
              <Border Width="4"
                      Margin="0,4"
                      HorizontalAlignment="Center"
                      Background="{DynamicResource SurfaceMutedBrush}"
                      CornerRadius="2" />
              <Track x:Name="PART_Track"
                     Margin="0,4"
                     IsDirectionReversed="True"
                     Focusable="False"
                     Maximum="{TemplateBinding Maximum}"
                     Minimum="{TemplateBinding Minimum}"
                     Orientation="{TemplateBinding Orientation}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                Style="{StaticResource InvisibleScrollBarPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SettingsScrollBarThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                Style="{StaticResource InvisibleScrollBarPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AboutSectionHeadingStyle"
           TargetType="TextBlock">
      <Setter Property="Margin" Value="0,24,0,8" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AboutLinkButtonStyle"
           BasedOn="{StaticResource QuietButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.RowSpan="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="0,4,0,8">
        <ItemsControl ItemsSource="{Binding Sections}"
                      KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsSectionViewModel}">
              <Button Style="{StaticResource SettingsNavigationButtonStyle}"
                      Command="{Binding SelectCommand}"
                      Content="{Binding Title}"
                      ToolTip="{Binding Description}"
                      automation:AutomationProperties.Name="{Binding AutomationName}"
                      automation:AutomationProperties.HelpText="{Binding Description}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid Grid.Row="0"
          Grid.Column="1"
          Margin="24,0,24,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            Margin="0,8,0,8"
            Visibility="{Binding IsSettingsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="22"
                     FontWeight="SemiBold"
                     Text="{Binding WorkspaceTitle}" />
          <TextBlock Margin="0,4,0,0"
                     FontSize="13"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding WorkspaceDescription}" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     automation:AutomationProperties.LiveSetting="Polite">
            <TextBlock.Text>
              <Binding Path="VisibleItemsSummary" />
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Right"
                    Visibility="{Binding IsGeneralSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock HorizontalAlignment="Right"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Release source" />
          <TextBlock Margin="0,2,0,0"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Text="{Binding SourceIdentity}"
                     automation:AutomationProperties.Name="{Binding SourceIdentity, StringFormat='Release source, {0}'}" />
        </StackPanel>
        <Button Grid.Column="1"
                Margin="20,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource UtilityActionButtonStyle}"
                Command="{Binding OpenRawTomlCommand}"
                Content="Open raw _TOML"
                ToolTip="{Binding OpenRawTomlAvailability}"
                Visibility="{Binding IsAdvancedSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                automation:AutomationProperties.Name="Open active configuration as raw TOML"
                automation:AutomationProperties.HelpText="{Binding OpenRawTomlAvailability}" />
      </Grid>

      <Grid Grid.Row="1">
        <ListBox x:Name="SettingsList"
                 behaviors:DragScrollBehavior.IsEnabled="True"
                 ItemsSource="{Binding FilteredSettings}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.PanningMode="VerticalOnly"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 KeyboardNavigation.TabNavigation="Continue"
                 Visibility="{Binding IsSettingsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                 automation:AutomationProperties.Name="Settings in the selected section">
          <ListBox.Resources>
            <Style BasedOn="{StaticResource SettingsScrollBarStyle}"
                   TargetType="{x:Type ScrollBar}" />
          </ListBox.Resources>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ContentControl HorizontalContentAlignment="Stretch"
                              Content="{Binding}">
                <ContentControl.Resources>
                  <DataTemplate DataType="{x:Type viewModels:AdvancedPatchEditingGateViewModel}">
                    <Border Margin="18,14,18,8"
                            Padding="18"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            automation:AutomationProperties.Name="{Binding StateAutomationName}"
                            automation:AutomationProperties.HelpText="{Binding WarningText}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding StateTitle}" />
                            <TextBlock MaxWidth="700"
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding StateDescription}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Margin="18,0,0,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource UtilityActionButtonStyle}"
                                  Command="{Binding LockCommand}"
                                  Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  automation:AutomationProperties.Name="Lock patch editing"
                                  automation:AutomationProperties.HelpText="Relock patch controls while preserving staged configuration changes.">
                            <AccessText Text="_Lock patch editing" />
                          </Button>
                        </Grid>

                        <TextBlock x:Name="PatchEditingWarning"
                                   MaxWidth="760"
                                   Margin="0,14,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding WarningText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   automation:AutomationProperties.Name="Patch editing safety warning" />

                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource UtilityActionButtonStyle}"
                                Command="{Binding EnableCommand}"
                                ToolTip="{Binding EnableAvailability}"
                                Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                automation:AutomationProperties.Name="Enable patch editing"
                                automation:AutomationProperties.LabeledBy="{Binding ElementName=PatchEditingWarning}"
                                automation:AutomationProperties.HelpText="{Binding EnableAutomationHelp}">
                          <AccessText Text="_Enable patch editing" />
                        </Button>

                        <Border Margin="0,18,0,0"
                                Padding="0,12,0,0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <StackPanel>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding SummaryTitle}"
                                       automation:AutomationProperties.HeadingLevel="Level3" />
                            <ItemsControl Margin="0,8,0,0"
                                          ItemsSource="{Binding Summaries}"
                                          automation:AutomationProperties.Name="Read-only patch value summary">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:AdvancedPatchSummaryItemViewModel}">
                                  <Grid Width="320"
                                        Margin="0,3,18,3"
                                        automation:AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding StateText}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type viewModels:SettingsGroupHeaderViewModel}">
                    <Border Margin="18,22,18,6"
                            Padding="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                      <TextBlock FontSize="20"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="{Binding Label}" />
                    </Border>
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type viewModels:SettingsFamilyHeaderViewModel}">
                    <StackPanel Margin="20,16,20,5">
                      <TextBlock FontSize="17"
                                 FontWeight="SemiBold"
                                 Text="{Binding Label}" />
                      <TextBlock Margin="0,4,0,0"
                                 FontSize="13"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Text="{Binding Description}"
                                 TextWrapping="Wrap"
                                 Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type viewModels:SettingsRowViewModel}">
              <Border BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1">
                <Border x:Name="RowInteractionSurface"
                        Margin="2"
                        Padding="16,13"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="8"
                        automation:AutomationProperties.Name="{Binding AccessibleName}"
                        automation:AutomationProperties.HelpText="{Binding AccessibleHelp}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="5*" MinWidth="220" />
                      <ColumnDefinition Width="4*" MinWidth="300" MaxWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,28,0"
                          VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock FontSize="16"
                                 FontWeight="SemiBold"
                                 Text="{Binding DisplayTitle}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Path}" />
                      <StackPanel Grid.Column="1"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal">
                        <Border Margin="0,0,7,0"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource QuietHoverBrush}"
                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock FontSize="11"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Text="Unsaved" />
                        </Border>
                        <Border Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                Visibility="{Binding IsExperimental, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Text="Experimental" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,5,0,0"
                                 FontSize="13"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Text="{Binding Description}"
                                 TextWrapping="Wrap"
                                 Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Center">
                      <Grid Visibility="{Binding IsBooleanEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding BooleanStateText}" />
                        <CheckBox Grid.Column="1"
                                  Margin="14,0,0,0"
                                  Style="{StaticResource BooleanEditorStyle}"
                                  IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEdit}"
                                  automation:AutomationProperties.Name="{Binding Title, StringFormat=Toggle {0}}"
                                  automation:AutomationProperties.HelpText="{Binding AccessibleHelp}" />
                        <controls:SettingsRowActions Grid.Column="2"
                                                     Margin="8,0,0,0" />
                      </Grid>

                      <StackPanel Visibility="{Binding IsEnumEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ComboBox Width="{StaticResource SettingsInputWidthLarge}"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SettingsEnumComboBoxStyle}"
                                    ItemsSource="{Binding EnumOptions}"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding EnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanEdit}"
                                    ToolTip="{Binding EnumValidationMessage}"
                                    automation:AutomationProperties.Name="{Binding Title, StringFormat=Choose {0}}"
                                    automation:AutomationProperties.HelpText="{Binding EnumValidationMessage}" />
                          <controls:SettingsRowActions Grid.Column="1"
                                                       Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Margin="0,4,52,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="Invalid override · Default shown"
                                   Visibility="{Binding EnumNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>

                      <StackPanel Visibility="{Binding IsNumericEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Slider Margin="0,0,12,0"
                                  Style="{StaticResource SettingsNumericSliderStyle}"
                                  Minimum="{Binding NumericSliderMinimum}"
                                  Maximum="{Binding NumericSliderMaximum}"
                                  SmallChange="{Binding NumericSliderStep}"
                                  LargeChange="{Binding NumericSliderLargeChange}"
                                  TickFrequency="{Binding NumericSliderStep}"
                                  IsSnapToTickEnabled="True"
                                  Value="{Binding NumericSliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEdit}"
                                  ToolTip="{Binding NumericValidationMessage}"
                                  Visibility="{Binding HasNumericSlider, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  automation:AutomationProperties.Name="{Binding Title, StringFormat=Adjust {0}}"
                                  automation:AutomationProperties.HelpText="{Binding NumericValidationMessage}" />
                          <TextBox Grid.Column="1"
                                   Style="{StaticResource SettingsNumericEditorStyle}"
                                   Text="{Binding NumericText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   IsEnabled="{Binding CanEdit}"
                                   ToolTip="{Binding NumericValidationMessage}"
                                   behaviors:TextInputCommitBehavior.CommitOnEnter="True"
                                   automation:AutomationProperties.Name="{Binding Title, StringFormat=Set {0}}"
                                   automation:AutomationProperties.HelpText="{Binding NumericValidationMessage}" />
                          <TextBlock Grid.Column="2"
                                     MinWidth="32"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Text="{Binding Unit}"
                                     Visibility="{Binding HasUnit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <controls:SettingsRowActions Grid.Column="3"
                                                       Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Margin="0,4,52,0"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding NumericValidationMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NumericValidationMessage}"
                                   Visibility="{Binding NumericNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>

                      <StackPanel Visibility="{Binding IsStringEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Width="{StaticResource SettingsInputWidthLarge}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource SettingsStringEditorStyle}"
                                   Text="{Binding StringText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   IsEnabled="{Binding CanEdit}"
                                   ToolTip="{Binding StringValidationMessage}"
                                   behaviors:TextInputCommitBehavior.CommitOnEnter="True"
                                   automation:AutomationProperties.Name="{Binding Title, StringFormat=Set {0}}"
                                   automation:AutomationProperties.HelpText="{Binding StringValidationMessage}" />
                          <controls:SettingsRowActions Grid.Column="1"
                                                       Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Margin="0,4,52,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding StringValidationMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StringValidationMessage}"
                                   Visibility="{Binding StringNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>

                      <StackPanel Visibility="{Binding IsKeybindingEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="{Binding KeybindingValidationMessage}"
                                  automation:AutomationProperties.Name="{Binding EditorAutomationName}"
                                  automation:AutomationProperties.HelpText="{Binding KeybindingValidationMessage}">
                        <WrapPanel HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                          <ItemsControl ItemsSource="{Binding KeybindingChords}">
                            <ItemsControl.Style>
                              <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsKeybindingUnbound}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type viewModels:SettingsKeybindingChord}">
                                <Border Margin="0,2,7,2"
                                        Padding="10,3,3,3"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding Display}" />
                                    <Button Width="36"
                                            Height="36"
                                            MinHeight="36"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Command="{Binding DataContext.RemoveKeybindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Canonical}"
                                            ToolTip="Remove this shortcut"
                                            automation:AutomationProperties.Name="{Binding RemoveAutomationName}">
                                      <controls:AppIcon Kind="Remove" />
                                    </Button>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <TextBlock Margin="8,0"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Text="Unbound">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsKeybindingUnbound}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <controls:SettingsRowActions Margin="8,2,0,2" />
                        </WrapPanel>
                        <TextBlock MaxWidth="420"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding KeybindingValidationMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding KeybindingValidationMessage}"
                                   Visibility="{Binding KeybindingNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>

                      <StackPanel Visibility="{Binding IsNotificationEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="{Binding NotificationPolicyHelp}"
                                  automation:AutomationProperties.Name="{Binding EditorAutomationName}"
                                  automation:AutomationProperties.HelpText="{Binding NotificationPolicyHelp}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ToggleButton Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource NotificationDeliveryToggleStyle}"
                                        IsChecked="{Binding NotificationSystem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanEdit}"
                                        ToolTip="Windows system notification"
                                        automation:AutomationProperties.Name="{Binding Title, StringFormat=Toggle system delivery for {0}}">
                            <controls:AppIcon Kind="Notification" />
                          </ToggleButton>
                          <ToggleButton Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource NotificationDeliveryToggleStyle}"
                                        IsChecked="{Binding NotificationAudio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanEdit}"
                                        ToolTip="In-game notification sound"
                                        automation:AutomationProperties.Name="{Binding Title, StringFormat=Toggle audio delivery for {0}}">
                            <controls:AppIcon Kind="Sound" />
                          </ToggleButton>
                          <ComboBox Grid.Column="3"
                                    Width="112"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SettingsEnumComboBoxStyle}"
                                    ItemsSource="{Binding NotificationSoundOptions}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding NotificationSound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanSelectNotificationSound}"
                                    ToolTip="Choose the in-game notification sound"
                                    automation:AutomationProperties.Name="{Binding Title, StringFormat=Choose sound for {0}}" />
                          <controls:SettingsRowActions Grid.Column="4"
                                                       Margin="8,0,0,0" />
                        </Grid>
                      </StackPanel>

                      <Border Padding="12,9"
                              Background="{DynamicResource SurfaceMutedBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="7"
                              Visibility="{Binding IsSpecializedEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                          <TextBlock FontSize="12"
                                     FontWeight="SemiBold"
                                     Text="{Binding EffectiveState}" />
                          <TextBlock Margin="0,3,0,0"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Text="{Binding SpecializedEditorMessage}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompactBindingFamily}" Value="True">
                  <Setter TargetName="RowInteractionSurface"
                          Property="Padding"
                          Value="16,7" />
                </DataTrigger>
                <Trigger SourceName="RowInteractionSurface"
                         Property="IsMouseOver"
                         Value="True">
                  <Setter TargetName="RowInteractionSurface"
                          Property="Background"
                          Value="{DynamicResource QuietHoverBrush}" />
                </Trigger>
                <Trigger SourceName="RowInteractionSurface"
                         Property="IsKeyboardFocusWithin"
                         Value="True">
                  <Setter TargetName="RowInteractionSurface"
                          Property="BorderBrush"
                          Value="{DynamicResource FocusOuterBrush}" />
                </Trigger>
              </DataTemplate.Triggers>
                  </DataTemplate>
                </ContentControl.Resources>
              </ContentControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Padding="34"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding EmptyStateVisibility}"
                automation:AutomationProperties.LiveSetting="Polite"
                automation:AutomationProperties.Name="No settings match the current filters">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Text="No settings found" />
            <TextBlock MaxWidth="420"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Try a different search or choose another category."
                       TextAlignment="Center" />
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Visibility="{Binding IsAboutSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                      automation:AutomationProperties.Name="About STFC Mod Control">
          <ScrollViewer.Resources>
            <Style BasedOn="{StaticResource SettingsScrollBarStyle}"
                   TargetType="{x:Type ScrollBar}" />
          </ScrollViewer.Resources>
          <StackPanel Margin="4,18,14,28">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="{Binding About.ProductName}" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="15"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{Binding About.Descriptor}" />
            <TextBlock MaxWidth="720"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Left"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding About.Description}"
                       TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource AboutSectionHeadingStyle}"
                       Text="Application" />
            <Border Height="1"
                    Margin="0,0,0,12"
                    Background="{DynamicResource BorderBrush}" />
            <Grid MaxWidth="760" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Version" />
              <TextBlock Grid.Column="1" Text="{Binding About.Version}" TextWrapping="Wrap"
                         automation:AutomationProperties.Name="{Binding About.Version, StringFormat='Mod Control version {0}'}" />
              <TextBlock Grid.Row="1" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Build" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding About.BuildProvenance}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mod provider" />
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" Text="{Binding About.Provider}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Detected runtime" />
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" Text="{Binding About.DetectedRuntime}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Release channel" />
              <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,7,0,0" Text="{Binding About.ReleaseChannel}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Runtime repository" />
              <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,7,0,0" Text="{Binding About.ReleaseRepository}" TextWrapping="Wrap" />
            </Grid>
            <WrapPanel Margin="0,16,0,0">
              <Button Style="{StaticResource AboutLinkButtonStyle}"
                      Command="{Binding About.OpenExternalLinkCommand}"
                      CommandParameter="{Binding About.RepositoryUrl}"
                      Content="View _source"
                      automation:AutomationProperties.Name="Open STFC Mod Control source repository" />
              <Button Style="{StaticResource AboutLinkButtonStyle}"
                      Command="{Binding About.OpenExternalLinkCommand}"
                      CommandParameter="{Binding About.ReleasesUrl}"
                      Content="View _releases"
                      automation:AutomationProperties.Name="Open STFC Mod Control releases" />
              <Button Style="{StaticResource AboutLinkButtonStyle}"
                      Command="{Binding About.OpenExternalLinkCommand}"
                      CommandParameter="{Binding About.ProductLicenseUrl}"
                      Content="Product _license"
                      automation:AutomationProperties.Name="Open STFC Mod Control license" />
              <Button Style="{StaticResource AboutLinkButtonStyle}"
                      Command="{Binding About.OpenExternalLinkCommand}"
                      CommandParameter="{Binding About.RuntimeRepositoryUrl}"
                      Content="Runtime source"
                      automation:AutomationProperties.Name="Open active mod provider repository" />
            </WrapPanel>

            <TextBlock Style="{StaticResource AboutSectionHeadingStyle}"
                       Text="Credits and acknowledgements" />
            <Border Height="1" Margin="0,0,0,10" Background="{DynamicResource BorderBrush}" />
            <ItemsControl ItemsSource="{Binding About.Contributors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,5,0,10">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock MaxWidth="720" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Contribution}" TextWrapping="Wrap" />
                    <Button Margin="-10,2,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource AboutLinkButtonStyle}"
                            Command="{Binding DataContext.About.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Url}" Content="View contribution source"
                            automation:AutomationProperties.Name="{Binding Name, StringFormat='Open contribution source for {0}'}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding About.Acknowledgements}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,5,0,10">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock MaxWidth="720" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Text}" TextWrapping="Wrap" />
                    <Button Margin="-10,2,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource AboutLinkButtonStyle}"
                            Command="{Binding DataContext.About.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Url}" Content="Learn more"
                            automation:AutomationProperties.Name="{Binding Title, StringFormat='Open acknowledgement source for {0}'}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource AboutSectionHeadingStyle}"
                       Text="Game and publisher acknowledgement" />
            <Border Height="1" Margin="0,0,0,10" Background="{DynamicResource BorderBrush}" />
            <TextBlock MaxWidth="720" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding About.GameAcknowledgement}" TextWrapping="Wrap" />
            <TextBlock MaxWidth="720" Margin="0,8,0,0" HorizontalAlignment="Left"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding About.LegalReviewStatus}" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource AboutSectionHeadingStyle}"
                       Text="Third-party notices" />
            <Border Height="1" Margin="0,0,0,10" Background="{DynamicResource BorderBrush}" />
            <TextBlock MaxWidth="720" Margin="0,0,0,8" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Expand a component to read its bundled notice and follow its authoritative source and license links."
                       TextWrapping="Wrap" />
            <TextBlock MaxWidth="720" Margin="0,0,0,10" HorizontalAlignment="Left"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding About.NoticeCoverageStatus}" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Third-party notice coverage status" />
            <ItemsControl ItemsSource="{Binding About.ThirdPartyNotices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Margin="0,2,0,4" Padding="0,6"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            automation:AutomationProperties.Name="{Binding Name, StringFormat='Third-party notice for {0}'}">
                    <Expander.Header>
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                          <Run Text="{Binding Version}" /><Run Text=" · " /><Run Text="{Binding License}" />
                        </TextBlock>
                      </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,8">
                      <TextBlock MaxWidth="690" FontFamily="Consolas" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Text="{Binding NoticeText}" TextWrapping="Wrap" />
                      <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource AboutLinkButtonStyle}"
                                Command="{Binding DataContext.About.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding SourceUrl}" Content="View source"
                                automation:AutomationProperties.Name="{Binding Name, StringFormat='Open source for {0}'}" />
                        <Button Style="{StaticResource AboutLinkButtonStyle}"
                                Command="{Binding DataContext.About.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding LicenseUrl}" Content="View license"
                                automation:AutomationProperties.Name="{Binding Name, StringFormat='Open license for {0}'}" />
                      </WrapPanel>
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Margin="0,22,0,0" Padding="0,6"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      automation:AutomationProperties.Name="Configuration ownership technical details">
              <Expander.Header>
                <StackPanel>
                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="Technical configuration details" />
                  <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="Provider identity, schema projection, and ownership." />
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="24,10,0,8">
                <TextBlock MaxWidth="700" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Mod Control stages sparse changes for the selected provider. Runtime defaults remain owned by the mod; unknown TOML keys and comments are preserved. Raw TOML editing belongs to Advanced."
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0" Text="{Binding About.ProviderId, StringFormat='Provider ID: {0}'}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding SemanticGroupingStatus, StringFormat='Semantic grouping: {0}'}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding SettingsLayoutName, StringFormat='Settings layout: {0}'}" />
                <TextBlock MaxWidth="700" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding SemanticGroupingReason}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <views:SyncView Grid.Row="0"
                    Grid.Column="1"
                    DataContext="{Binding SyncWorkspace}"
                    Visibility="{Binding DataContext.IsDataSyncSelected, ElementName=SettingsRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />

    <Border Grid.Row="1"
            Grid.Column="1"
            Padding="20,8,24,8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding IsSettingsFooterVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            automation:AutomationProperties.Name="{Binding PendingChangesText}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Text="{Binding PendingChangesText}"
                     automation:AutomationProperties.LiveSetting="Polite" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding PendingApplyTimingText}" />
          <TextBlock MaxWidth="520"
                     Margin="0,3,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding OperationStatus}"
                     TextTrimming="CharacterEllipsis"
                     automation:AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
          <Button MinWidth="100"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding DiscardCommand}"
                  Content="_Discard"
                  automation:AutomationProperties.Name="Discard unsaved configuration changes" />
          <Button MinWidth="132"
                  Margin="12,0,0,0"
                  Command="{Binding SaveCommand}"
                  Content="_Save changes"
                  ToolTip="{Binding SaveAvailability}"
                  automation:AutomationProperties.Name="Save configuration changes"
                  automation:AutomationProperties.HelpText="{Binding SaveAvailability}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
