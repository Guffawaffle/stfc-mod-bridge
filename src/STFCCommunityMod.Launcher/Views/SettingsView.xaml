<UserControl x:Class="STFCCommunityMod.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:behaviors="clr-namespace:STFCCommunityMod.Launcher.Behaviors"
             xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:viewModels="clr-namespace:STFCCommunityMod.Launcher.ViewModels"
             MinWidth="760"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Focusable="False"
             automation:AutomationProperties.Name="Mod settings">
  <UserControl.Resources>
    <Style x:Key="SettingsSearchStyle"
           TargetType="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SettingsNavigationButtonStyle"
           BasedOn="{StaticResource QuietButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsNumericEditorStyle"
           BasedOn="{StaticResource SettingsSearchStyle}"
           TargetType="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MaxLength" Value="64" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding NumericNeedsAttention}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsStringEditorStyle"
           BasedOn="{StaticResource SettingsSearchStyle}"
           TargetType="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MaxLength" Value="2048" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StringNeedsAttention}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NotificationDeliveryToggleStyle"
           TargetType="ToggleButton">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToggleSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource FocusOuterBrush}" />
                <Setter TargetName="ToggleSurface"
                        Property="BorderThickness"
                        Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.58" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BooleanEditorStyle"
           TargetType="CheckBox">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style>
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <Border BorderBrush="{DynamicResource FocusOuterBrush}"
                          BorderThickness="2"
                          CornerRadius="13" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="ToggleTrack"
                    Width="44"
                    Height="24"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
              <Ellipse x:Name="ToggleThumb"
                       Width="16"
                       Height="16"
                       Margin="4,0,0,0"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack"
                        Property="Background"
                        Value="{DynamicResource SuccessSoftBrush}" />
                <Setter TargetName="ToggleTrack"
                        Property="BorderBrush"
                        Value="{DynamicResource SuccessBrush}" />
                <Setter TargetName="ToggleThumb"
                        Property="HorizontalAlignment"
                        Value="Right" />
                <Setter TargetName="ToggleThumb"
                        Property="Margin"
                        Value="0,0,4,0" />
                <Setter TargetName="ToggleThumb"
                        Property="Fill"
                        Value="{DynamicResource SuccessBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleTrack"
                        Property="BorderThickness"
                        Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsEnumItemStyle"
           TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="automation:AutomationProperties.Name"
              Value="{Binding Label}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface"
                        Property="Background"
                        Value="{DynamicResource QuietHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsEnumComboBoxStyle"
           TargetType="ComboBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MaxDropDownHeight" Value="260" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsEnumItemStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ControlSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1"
                              Width="10"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1,1 L 5,5 L 9,1"
                              Stretch="None"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.5" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ControlSurface"
                                Property="BorderBrush"
                                Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ControlSurface"
                                Property="BorderBrush"
                                Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="12,0,40,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" />

              <Border x:Name="KeyboardFocusBorder"
                      BorderBrush="{DynamicResource FocusOuterBrush}"
                      BorderThickness="2"
                      CornerRadius="8"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PlacementTarget="{Binding ElementName=DropDownToggle}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,4,0,0"
                        Padding="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                  <ScrollViewer CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="KeyboardFocusBorder"
                        Property="Visibility"
                        Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InvisibleScrollBarPageButtonStyle"
           TargetType="{x:Type primitives:RepeatButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:RepeatButton}">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsScrollBarThumbStyle"
           TargetType="{x:Type primitives:Thumb}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:Thumb}">
            <Border x:Name="ThumbSurface"
                    Width="6"
                    Margin="0,2"
                    HorizontalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="3" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Width"
                        Value="8" />
                <Setter Property="Background"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Width"
                        Value="8" />
                <Setter Property="Background"
                        Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsScrollBarStyle"
           TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}">
              <Border Width="4"
                      Margin="0,4"
                      HorizontalAlignment="Center"
                      Background="{DynamicResource SurfaceMutedBrush}"
                      CornerRadius="2" />
              <Track x:Name="PART_Track"
                     Margin="0,4"
                     IsDirectionReversed="True"
                     Focusable="False"
                     Maximum="{TemplateBinding Maximum}"
                     Minimum="{TemplateBinding Minimum}"
                     Orientation="{TemplateBinding Orientation}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                Style="{StaticResource InvisibleScrollBarPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SettingsScrollBarThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                Style="{StaticResource InvisibleScrollBarPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.RowSpan="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="0,4,0,8">
        <ItemsControl ItemsSource="{Binding Sections}"
                      KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsSectionViewModel}">
              <Button Style="{StaticResource SettingsNavigationButtonStyle}"
                      Command="{Binding SelectCommand}"
                      Content="{Binding Title}"
                      ToolTip="{Binding Description}"
                      automation:AutomationProperties.Name="{Binding AutomationName}"
                      automation:AutomationProperties.HelpText="{Binding Description}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid Grid.Row="0"
          Grid.Column="1"
          Margin="24,0,24,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid MaxWidth="650"
            Margin="0,8,0,0"
            HorizontalAlignment="Stretch"
            Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBox x:Name="SearchBox"
                 HorizontalAlignment="Stretch"
                 Style="{StaticResource SettingsSearchStyle}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 automation:AutomationProperties.Name="Search settings"
                 automation:AutomationProperties.HelpText="Search every setting by name, description, category, or canonical key." />
        <TextBlock Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsHitTestVisible="False"
                   Text="Search settings">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <Grid Grid.Row="1"
            Margin="0,8,0,8"
            Visibility="{Binding IsSettingsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="13"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding WorkspaceDescription}" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     automation:AutomationProperties.LiveSetting="Polite">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} settings shown · {1}">
                <Binding Path="VisibleSettingCount" />
                <Binding Path="ConfigurationStatus" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Right"
                    Visibility="{Binding IsGeneralSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock HorizontalAlignment="Right"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Release source" />
          <TextBlock Margin="0,2,0,0"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Text="{Binding SourceIdentity}"
                     automation:AutomationProperties.Name="{Binding SourceIdentity, StringFormat='Release source, {0}'}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2">
        <ListBox x:Name="SettingsList"
                 behaviors:DragScrollBehavior.IsEnabled="True"
                 ItemsSource="{Binding FilteredSettings}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.PanningMode="VerticalOnly"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 KeyboardNavigation.TabNavigation="Continue"
                 Visibility="{Binding IsSettingsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                 automation:AutomationProperties.Name="Settings in the selected section">
          <ListBox.Resources>
            <Style BasedOn="{StaticResource SettingsScrollBarStyle}"
                   TargetType="{x:Type ScrollBar}" />
          </ListBox.Resources>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsRowViewModel}">
              <Border Padding="16,15"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1"
                      automation:AutomationProperties.Name="{Binding Title}"
                      automation:AutomationProperties.HelpText="{Binding Description}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="290" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Margin="0,0,24,0"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="15"
                                 FontWeight="SemiBold"
                                 Text="{Binding Title}"
                                 ToolTip="{Binding Path}" />
                      <TextBlock Margin="9,0,0,0"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Text="Unsaved"
                                 Visibility="{Binding IsStaged, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Description}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ApplyState}" />
                  </StackPanel>

                  <Grid Grid.Column="1"
                        VerticalAlignment="Center">
                    <Grid Visibility="{Binding IsBooleanEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding BooleanStateText}" />
                        <Button Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource QuietButtonStyle}"
                                Command="{Binding RemoveOverrideCommand}"
                                Content="Use default"
                                ToolTip="{Binding RemoveOverrideAvailability}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Use default for {0}}"
                                automation:AutomationProperties.HelpText="{Binding RemoveOverrideAvailability}" />
                      </StackPanel>
                      <CheckBox Grid.Column="1"
                                Margin="14,0,0,0"
                                Style="{StaticResource BooleanEditorStyle}"
                                IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding CanEdit}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Toggle {0}}"
                                automation:AutomationProperties.HelpText="{Binding Description}" />
                    </Grid>

                    <StackPanel Visibility="{Binding IsEnumEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <ComboBox Style="{StaticResource SettingsEnumComboBoxStyle}"
                                ItemsSource="{Binding EnumOptions}"
                                DisplayMemberPath="Label"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding EnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding CanEdit}"
                                ToolTip="{Binding EnumValidationMessage}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Choose {0}}"
                                automation:AutomationProperties.HelpText="{Binding EnumValidationMessage}" />
                      <Grid Margin="0,4,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="Invalid override · Default shown"
                                   Visibility="{Binding EnumNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource QuietButtonStyle}"
                                Command="{Binding RemoveOverrideCommand}"
                                Content="Use default"
                                ToolTip="{Binding RemoveOverrideAvailability}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Use default for {0}}"
                                automation:AutomationProperties.HelpText="{Binding RemoveOverrideAvailability}" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsNumericEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBox Style="{StaticResource SettingsNumericEditorStyle}"
                               Text="{Binding NumericText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               IsEnabled="{Binding CanEdit}"
                               ToolTip="{Binding NumericValidationMessage}"
                               behaviors:TextInputCommitBehavior.CommitOnEnter="True"
                               automation:AutomationProperties.Name="{Binding Title, StringFormat=Set {0}}"
                               automation:AutomationProperties.HelpText="{Binding NumericValidationMessage}" />
                      <Grid Margin="0,4,0,0">
                        <TextBlock MaxWidth="150"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding NumericConstraintText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NumericConstraintText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding NumericNeedsAttention}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock MaxWidth="150"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding NumericValidationMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NumericValidationMessage}"
                                   Visibility="{Binding NumericNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource QuietButtonStyle}"
                                Command="{Binding RemoveOverrideCommand}"
                                Content="Use default"
                                ToolTip="{Binding RemoveOverrideAvailability}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Use default for {0}}"
                                automation:AutomationProperties.HelpText="{Binding RemoveOverrideAvailability}" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsStringEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBox Style="{StaticResource SettingsStringEditorStyle}"
                               Text="{Binding StringText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               IsEnabled="{Binding CanEdit}"
                               ToolTip="{Binding StringValidationMessage}"
                               behaviors:TextInputCommitBehavior.CommitOnEnter="True"
                               automation:AutomationProperties.Name="{Binding Title, StringFormat=Set {0}}"
                               automation:AutomationProperties.HelpText="{Binding StringValidationMessage}" />
                      <Grid Margin="0,4,0,0">
                        <TextBlock MaxWidth="190"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding StringInputHint}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StringInputHint}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StringNeedsAttention}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock MaxWidth="190"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding StringValidationMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StringValidationMessage}"
                                   Visibility="{Binding StringNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource QuietButtonStyle}"
                                Command="{Binding RemoveOverrideCommand}"
                                Content="Use default"
                                ToolTip="{Binding RemoveOverrideAvailability}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Use default for {0}}"
                                automation:AutomationProperties.HelpText="{Binding RemoveOverrideAvailability}" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsKeybindingEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Border Padding="8"
                              Background="{DynamicResource SurfaceMutedBrush}"
                              BorderThickness="1"
                              CornerRadius="7"
                              ToolTip="{Binding KeybindingValidationMessage}"
                              automation:AutomationProperties.Name="{Binding EditorAutomationName}"
                              automation:AutomationProperties.HelpText="{Binding KeybindingValidationMessage}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding KeybindingNeedsAttention}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Grid Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding KeybindingChords}">
                              <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeybindingUnbound}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ItemsControl.Style>
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:SettingsKeybindingChord}">
                                  <Border Margin="0,2,6,2"
                                          Padding="8,4,3,4"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          BorderThickness="1"
                                          CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock VerticalAlignment="Center"
                                                 FontSize="12"
                                                 FontWeight="SemiBold"
                                                 Text="{Binding Display}" />
                                      <Button Width="22"
                                              Height="22"
                                              MinHeight="22"
                                              Margin="5,0,0,0"
                                              Padding="0"
                                              Style="{StaticResource QuietButtonStyle}"
                                              Command="{Binding DataContext.RemoveKeybindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Canonical}"
                                              ToolTip="Remove this shortcut"
                                              automation:AutomationProperties.Name="{Binding RemoveAutomationName}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Text="&#xE711;" />
                                      </Button>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="6,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Unbound">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeybindingUnbound}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>

                          <controls:KeybindingCaptureButton Grid.Column="1"
                                                            Width="36"
                                                            Height="36"
                                                            MinHeight="36"
                                                            Padding="0"
                                                            Style="{StaticResource QuietButtonStyle}"
                                                            Prompt="+"
                                                            CapturedCommand="{Binding AddKeybindingCommand}"
                                                            IsEnabled="{Binding CanEdit}"
                                                            ToolTip="Add another shortcut"
                                                            automation:AutomationProperties.Name="{Binding Title, StringFormat=Add an alternative shortcut for {0}}"
                                                            automation:AutomationProperties.HelpText="Press a keyboard key or mouse button. Escape cancels." />
                          <Button Grid.Column="2"
                                  Width="36"
                                  Height="36"
                                  MinHeight="36"
                                  Margin="6,0,0,0"
                                  Padding="0"
                                  Style="{StaticResource QuietButtonStyle}"
                                  Command="{Binding UnbindKeybindingCommand}"
                                  ToolTip="Unbind this action"
                                  automation:AutomationProperties.Name="{Binding Title, StringFormat=Unbind {0}}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE738;" />
                          </Button>
                          <Button Grid.Column="3"
                                  Width="36"
                                  Height="36"
                                  MinHeight="36"
                                  Margin="6,0,0,0"
                                  Padding="0"
                                  Style="{StaticResource QuietButtonStyle}"
                                  Command="{Binding RemoveOverrideCommand}"
                                  ToolTip="{Binding RemoveOverrideAvailability}"
                                  Visibility="{Binding HasOverride, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  automation:AutomationProperties.Name="{Binding Title, StringFormat=Use default for {0}}"
                                  automation:AutomationProperties.HelpText="{Binding RemoveOverrideAvailability}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE777;" />
                          </Button>
                        </Grid>
                      </Border>
                      <TextBlock MaxWidth="290"
                                 Margin="0,4,0,0"
                                 FontSize="11"
                                 Foreground="{DynamicResource WarningBrush}"
                                 Text="{Binding KeybindingValidationMessage}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding KeybindingValidationMessage}"
                                 Visibility="{Binding KeybindingNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsNotificationEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Border Padding="8"
                              Background="{DynamicResource SurfaceMutedBrush}"
                              BorderThickness="1"
                              CornerRadius="7"
                              ToolTip="{Binding NotificationPolicyHelp}"
                              automation:AutomationProperties.Name="{Binding EditorAutomationName}"
                              automation:AutomationProperties.HelpText="{Binding NotificationPolicyHelp}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NotificationNeedsAttention}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Width="26"
                                     VerticalAlignment="Center"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Text="{Binding NotificationStateText}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding NotificationStateText}" Value="On">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding NotificationNeedsAttention}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <ToggleButton Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource NotificationDeliveryToggleStyle}"
                                        IsChecked="{Binding NotificationSystem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanEdit}"
                                        ToolTip="Windows system notification"
                                        automation:AutomationProperties.Name="{Binding Title, StringFormat=Toggle system delivery for {0}}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Text="&#xE7E7;" />
                          </ToggleButton>
                          <ToggleButton Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource NotificationDeliveryToggleStyle}"
                                        IsChecked="{Binding NotificationAudio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanEdit}"
                                        ToolTip="In-game notification sound"
                                        automation:AutomationProperties.Name="{Binding Title, StringFormat=Toggle audio delivery for {0}}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Text="&#xE767;" />
                          </ToggleButton>
                          <ComboBox Grid.Column="3"
                                    MinWidth="94"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SettingsEnumComboBoxStyle}"
                                    ItemsSource="{Binding NotificationSoundOptions}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding NotificationSound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanSelectNotificationSound}"
                                    ToolTip="Choose the in-game notification sound"
                                    automation:AutomationProperties.Name="{Binding Title, StringFormat=Choose sound for {0}}" />
                          <Button Grid.Column="4"
                                  Width="36"
                                  Height="36"
                                  MinHeight="36"
                                  Margin="8,0,0,0"
                                  Padding="0"
                                  Style="{StaticResource QuietButtonStyle}"
                                  Command="{Binding RemoveOverrideCommand}"
                                  ToolTip="{Binding RemoveOverrideAvailability}"
                                  Visibility="{Binding HasOverride, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  automation:AutomationProperties.Name="{Binding Title, StringFormat=Use default for {0}}"
                                  automation:AutomationProperties.HelpText="{Binding RemoveOverrideAvailability}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE777;" />
                          </Button>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <Border Padding="12,9"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding IsSpecializedEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding EffectiveState}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SpecializedEditorMessage}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Padding="34"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding EmptyStateVisibility}"
                automation:AutomationProperties.LiveSetting="Polite"
                automation:AutomationProperties.Name="No settings match the current filters">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Text="No settings found" />
            <TextBlock MaxWidth="420"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Try a different search or choose another category."
                       TextAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsAboutSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="Configuration ownership" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="The launcher stages sparse changes for the selected release source. Runtime defaults remain owned by the mod, and unknown TOML keys and comments are preserved." />
            <TextBlock Margin="0,18,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Active release source" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding SourceIdentity}" />
            <Button Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource UtilityActionButtonStyle}"
                    Command="{Binding OpenRawTomlCommand}"
                    Content="Open raw _TOML"
                    ToolTip="{Binding OpenRawTomlAvailability}"
                    automation:AutomationProperties.Name="Open active configuration as raw TOML"
                    automation:AutomationProperties.HelpText="{Binding OpenRawTomlAvailability}" />
            <TextBlock MaxWidth="520"
                       Margin="0,7,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding OpenRawTomlAvailability}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="1"
            Grid.Column="1"
            Padding="20,8,24,8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
            automation:AutomationProperties.Name="{Binding PendingChangesText}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Text="{Binding PendingChangesText}"
                     automation:AutomationProperties.LiveSetting="Polite" />
          <TextBlock Grid.Column="1"
                     MaxWidth="520"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding OperationStatus}"
                     TextTrimming="CharacterEllipsis"
                     automation:AutomationProperties.LiveSetting="Assertive" />
        </Grid>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
          <Button MinWidth="100"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding DiscardCommand}"
                  Content="_Discard"
                  automation:AutomationProperties.Name="Discard unsaved configuration changes" />
          <Button MinWidth="132"
                  Margin="12,0,0,0"
                  Command="{Binding SaveCommand}"
                  Content="_Save changes"
                  ToolTip="{Binding SaveAvailability}"
                  automation:AutomationProperties.Name="Save configuration changes"
                  automation:AutomationProperties.HelpText="{Binding SaveAvailability}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
