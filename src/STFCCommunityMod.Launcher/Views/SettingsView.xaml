<UserControl x:Class="STFCCommunityMod.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:viewModels="clr-namespace:STFCCommunityMod.Launcher.ViewModels"
             MinWidth="760"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Focusable="False"
             automation:AutomationProperties.Name="Mod settings">
  <UserControl.Resources>
    <Style x:Key="SettingsSearchStyle"
           TargetType="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SettingsNavigationButtonStyle"
           BasedOn="{StaticResource QuietButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BooleanEditorStyle"
           TargetType="CheckBox">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style>
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <Border BorderBrush="{DynamicResource FocusOuterBrush}"
                          BorderThickness="2"
                          CornerRadius="13" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="ToggleTrack"
                    Width="44"
                    Height="24"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
              <Ellipse x:Name="ToggleThumb"
                       Width="16"
                       Height="16"
                       Margin="4,0,0,0"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack"
                        Property="Background"
                        Value="{DynamicResource SuccessSoftBrush}" />
                <Setter TargetName="ToggleTrack"
                        Property="BorderBrush"
                        Value="{DynamicResource SuccessBrush}" />
                <Setter TargetName="ToggleThumb"
                        Property="HorizontalAlignment"
                        Value="Right" />
                <Setter TargetName="ToggleThumb"
                        Property="Margin"
                        Value="0,0,4,0" />
                <Setter TargetName="ToggleThumb"
                        Property="Fill"
                        Value="{DynamicResource SuccessBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleTrack"
                        Property="BorderThickness"
                        Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.RowSpan="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="0,18,0,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
                Style="{StaticResource SettingsNavigationButtonStyle}"
                Command="{Binding NavigateHomeCommand}"
                Content="_Home"
                automation:AutomationProperties.Name="Return to launcher home" />

        <ItemsControl Grid.Row="1"
                      Margin="0,4,0,0"
                      ItemsSource="{Binding Sections}"
                      KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsSectionViewModel}">
              <Button Style="{StaticResource SettingsNavigationButtonStyle}"
                      Tag="{Binding IsSelected}"
                      Command="{Binding SelectCommand}"
                      Content="{Binding Title}"
                      ToolTip="{Binding Description}"
                      automation:AutomationProperties.Name="{Binding AutomationName}"
                      automation:AutomationProperties.HelpText="{Binding Description}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2"
                    Margin="22,12,18,0">
          <TextBlock FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Release source" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Text="{Binding SourceIdentity}"
                     automation:AutomationProperties.Name="{Binding SourceIdentity, StringFormat='Release source, {0}'}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1"
          Margin="32,22,32,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid MaxWidth="650"
            HorizontalAlignment="Stretch">
        <TextBox x:Name="SearchBox"
                 HorizontalAlignment="Stretch"
                 Style="{StaticResource SettingsSearchStyle}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 automation:AutomationProperties.Name="Search settings"
                 automation:AutomationProperties.HelpText="Search every setting by name, description, category, or canonical key." />
        <TextBlock Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsHitTestVisible="False"
                   Text="Search settings">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <StackPanel Grid.Row="1"
                  Margin="0,22,0,0">
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="{Binding WorkspaceTitle}" />
        <TextBlock Margin="0,5,0,0"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding WorkspaceDescription}" />
      </StackPanel>

      <Grid Grid.Row="2"
            Margin="0,14,0,10"
            Visibility="{Binding IsSettingsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="13"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding VisibleSettingCount, StringFormat={}{0} settings shown}"
                     automation:AutomationProperties.LiveSetting="Polite" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding ConfigurationStatus}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding FilteredSettings}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 KeyboardNavigation.TabNavigation="Continue"
                 Visibility="{Binding IsSettingsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                 automation:AutomationProperties.Name="Settings in the selected section">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsRowViewModel}">
              <Border Padding="16,15"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1"
                      automation:AutomationProperties.Name="{Binding Title}"
                      automation:AutomationProperties.HelpText="{Binding Description}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Margin="0,0,24,0"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="15"
                                 FontWeight="SemiBold"
                                 Text="{Binding Title}"
                                 ToolTip="{Binding Path}" />
                      <TextBlock Margin="9,0,0,0"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Text="Unsaved"
                                 Visibility="{Binding IsStaged, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Description}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ApplyState}" />
                  </StackPanel>

                  <Grid Grid.Column="1"
                        VerticalAlignment="Center">
                    <Grid Visibility="{Binding IsBooleanEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding BooleanStateText}" />
                        <Button Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource QuietButtonStyle}"
                                Command="{Binding RemoveOverrideCommand}"
                                Content="Use default"
                                ToolTip="{Binding RemoveOverrideAvailability}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Use default for {0}}"
                                automation:AutomationProperties.HelpText="{Binding RemoveOverrideAvailability}" />
                      </StackPanel>
                      <CheckBox Grid.Column="1"
                                Margin="14,0,0,0"
                                Style="{StaticResource BooleanEditorStyle}"
                                IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding CanEdit}"
                                automation:AutomationProperties.Name="{Binding Title, StringFormat=Toggle {0}}"
                                automation:AutomationProperties.HelpText="{Binding Description}" />
                    </Grid>

                    <Border Padding="12,9"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ToolTip="{Binding NotificationPolicyHelp}"
                            Visibility="{Binding IsNotificationEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                            automation:AutomationProperties.Name="{Binding EditorAutomationName}"
                            automation:AutomationProperties.HelpText="{Binding NotificationPolicyHelp}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding NotificationStateText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationStateText}" Value="On">
                                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationNeedsAttention}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding NotificationDeliverySummary}"
                                   TextAlignment="Right" />
                      </Grid>
                    </Border>

                    <Border Padding="12,9"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding IsSpecializedEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding EffectiveState}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SpecializedEditorMessage}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Padding="34"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding EmptyStateVisibility}"
                automation:AutomationProperties.LiveSetting="Polite"
                automation:AutomationProperties.Name="No settings match the current filters">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Text="No settings found" />
            <TextBlock MaxWidth="420"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Try a different search or choose another category."
                       TextAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsAboutSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="Configuration ownership" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="The launcher stages sparse changes for the selected release source. Runtime defaults remain owned by the mod, and unknown TOML keys and comments are preserved." />
            <TextBlock Margin="0,18,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Active release source" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding SourceIdentity}" />
            <Button Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource UtilityActionButtonStyle}"
                    Command="{Binding OpenRawTomlCommand}"
                    Content="Open raw _TOML"
                    ToolTip="{Binding OpenRawTomlAvailability}"
                    automation:AutomationProperties.Name="Open active configuration as raw TOML"
                    automation:AutomationProperties.HelpText="{Binding OpenRawTomlAvailability}" />
            <TextBlock MaxWidth="520"
                       Margin="0,7,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding OpenRawTomlAvailability}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="1"
            Grid.Column="1"
            Padding="24,14,32,14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Text="{Binding PendingChangesText}"
                     automation:AutomationProperties.LiveSetting="Polite" />
          <TextBlock MaxWidth="520"
                     Margin="0,3,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding OperationStatus}"
                     automation:AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
          <Button MinWidth="100"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding DiscardCommand}"
                  Content="_Discard"
                  automation:AutomationProperties.Name="Discard unsaved configuration changes" />
          <Button MinWidth="132"
                  Margin="12,0,0,0"
                  Command="{Binding SaveCommand}"
                  Content="_Save changes"
                  automation:AutomationProperties.Name="Save configuration changes" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
