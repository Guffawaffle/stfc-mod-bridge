<UserControl x:Class="STFCCommunityMod.Launcher.Views.SyncView"
             x:Name="SyncRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:viewModels="clr-namespace:STFCCommunityMod.Launcher.ViewModels"
             xmlns:views="clr-namespace:STFCCommunityMod.Launcher.Views"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Focusable="False"
             PreviewKeyDown="SyncRoot_PreviewKeyDown"
             automation:AutomationProperties.Name="Data Sync workspace">
  <UserControl.Resources>
    <views:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

    <Style x:Key="SyncFieldStyle" TargetType="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SyncPasswordStyle" TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SyncComboItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SyncComboStyle" TargetType="ComboBox">
      <Setter Property="MinHeight" Value="42" /><Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SyncComboItemStyle}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="DropDownToggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                <TextBlock Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Text="⌄" />
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <TextBlock Margin="11,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" />
          <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownToggle}">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Padding="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="7">
              <ScrollViewer CanContentScroll="True" MaxHeight="260" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SyncSwitchStyle" TargetType="CheckBox">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="44" Height="24"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12">
              <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="4,0,0,0"
                       HorizontalAlignment="Left" Fill="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                <Setter TargetName="Thumb" Property="Fill" Value="White" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" />
                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegmentButtonStyle" TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabButtonStyle" TargetType="ToggleButton">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8,8,0,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource QuietHoverBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,24,0,8" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ThinScrollThumb" TargetType="{x:Type primitives:Thumb}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type primitives:Thumb}">
        <Border x:Name="ThumbSurface" Width="6" Margin="0,2" HorizontalAlignment="Center"
                Background="{DynamicResource ControlBorderBrush}" CornerRadius="3" />
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Width" Value="8" /><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Width" Value="8" /><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentHoverBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SyncScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="12" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ScrollBar}">
        <Grid><Border Width="4" Margin="0,4" HorizontalAlignment="Center" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="2" />
          <Track x:Name="PART_Track" Margin="0,4" IsDirectionReversed="True" Focusable="False"
                 Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}" Orientation="{TemplateBinding Orientation}"
                 Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" /></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ThinScrollThumb}" /></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" /></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <ScrollViewer x:Name="PageScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                  automation:AutomationProperties.Name="Data Sync page content">
      <ScrollViewer.Resources><Style BasedOn="{StaticResource SyncScrollBarStyle}" TargetType="{x:Type ScrollBar}" /></ScrollViewer.Resources>
      <StackPanel Margin="24,12,18,24">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Data Sync" />
            <controls:HelpFlyoutButton Margin="8,0,0,0"
                                       AutomationName="About Data Sync editing"
                                       HelpText="Shared defaults apply across configured destinations. Edits remain staged until Save. The running game keeps its startup topology until restart." />
          </StackPanel>
          <Button x:Name="AddDestinationButton" Grid.Column="1" Command="{Binding OpenAddDestinationCommand}" Content="Add destination"
                  automation:AutomationProperties.Name="Add Data Sync destination" />
        </Grid>

        <Border Margin="0,14,0,0" Padding="12,9" Background="{DynamicResource WarningSoftBrush}" CornerRadius="7"
                Visibility="{Binding RestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                automation:AutomationProperties.LiveSetting="Polite">
          <TextBlock Foreground="{DynamicResource WarningBrush}"
                     Text="Data Sync was saved. Restart the running game to activate the new topology." />
        </Border>

        <Grid Margin="0,18,0,0" PreviewKeyDown="TabStrip_PreviewKeyDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="GlobalTabButton" Style="{StaticResource TabButtonStyle}" Content="Global defaults"
                        IsChecked="{Binding IsGlobalTabSelected, Mode=OneWay}" Click="GlobalTab_Click"
                        automation:AutomationProperties.Name="Global Data Sync defaults tab" />
          <Button x:Name="ScrollTabsLeftButton" Grid.Column="1" Width="34" MinHeight="48" Padding="0" Margin="3,0"
                  Style="{StaticResource SecondaryButtonStyle}" Content="‹" Click="ScrollTabsLeft_Click"
                  automation:AutomationProperties.Name="Scroll destination tabs left" />
          <ScrollViewer x:Name="DestinationTabScrollViewer" Grid.Column="2"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        PanningMode="HorizontalOnly" PreviewMouseWheel="DestinationTabs_PreviewMouseWheel"
                        ScrollChanged="DestinationTabs_ScrollChanged" SizeChanged="DestinationTabs_SizeChanged"
                        automation:AutomationProperties.Name="Destination tab overflow">
            <ItemsControl x:Name="DestinationTabs" ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding IsGlobal}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:SyncWorkspaceTabViewModel}">
                  <ToggleButton Style="{StaticResource TabButtonStyle}" Click="DestinationTab_Click"
                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                automation:AutomationProperties.Name="{Binding AutomationName}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,2,0,0" FontSize="10" Text="{Binding SecondaryLabel}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                          <Style.Triggers><DataTrigger Binding="{Binding Destination.NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button x:Name="ScrollTabsRightButton" Grid.Column="3" Width="34" MinHeight="48" Padding="0" Margin="3,0,0,0"
                  Style="{StaticResource SecondaryButtonStyle}" Content="›" Click="ScrollTabsRight_Click"
                  automation:AutomationProperties.Name="Scroll destination tabs right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderBrush}" />

        <StackPanel Visibility="{Binding IsGlobalTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Connection and security defaults" />
          <Border Height="1" Background="{DynamicResource BorderBrush}" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="Proxy" /><TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Blank means no global proxy." /></StackPanel>
            <TextBox Grid.Column="1" Margin="12,0,28,0" Style="{StaticResource SyncFieldStyle}"
                     Text="{Binding GlobalProxy, UpdateSourceTrigger=LostFocus}" automation:AutomationProperties.Name="Global proxy" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="Verify TLS" /><TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Validate server certificates." /></StackPanel>
            <CheckBox Grid.Column="3" Style="{StaticResource SyncSwitchStyle}" IsChecked="{Binding GlobalVerifySsl}"
                      automation:AutomationProperties.Name="Verify TLS globally" />
          </Grid>
          <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource WarningSoftBrush}" CornerRadius="7"
                  Visibility="{Binding GlobalVerifySsl, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Text="Certificate verification is disabled" />
                <TextBlock Margin="0,3,18,0" Text="Saving this unsafe state requires an explicit acknowledgement." /></StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource SyncSwitchStyle}" IsChecked="{Binding GlobalUnsafeTls}"
                        automation:AutomationProperties.Name="Acknowledge unsafe TLS globally" />
            </Grid>
          </Border>

          <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Feed defaults" />
          <Border Height="1" Background="{DynamicResource BorderBrush}" />
          <TextBlock Margin="0,9,0,12" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Feed defaults are inherited by configured sync destinations. Sidecar destinations retain their own defaults unless explicitly overridden." />
          <ItemsControl ItemsSource="{Binding GlobalFeeds}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type viewModels:SyncGlobalFeedViewModel}">
                <Grid Width="355" Margin="0,0,18,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" /></StackPanel>
                  <CheckBox Grid.Column="1" Style="{StaticResource SyncSwitchStyle}" IsChecked="{Binding IsEnabled}"
                            automation:AutomationProperties.Name="{Binding Label, StringFormat='Global {0} feed'}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Margin="0,12,0,0" Padding="14" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="7"
                  Visibility="{Binding HasLegacyRootTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock FontWeight="SemiBold" Text="Older root sync migration required" />
                <TextBlock Margin="0,3,18,0" FontSize="12" Text="Move sync.url and sync.token into a named destination when saving." /></StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource SyncSwitchStyle}" IsChecked="{Binding MigrateLegacyRoot}" />
            </Grid>
          </Border>
        </StackPanel>

        <ContentControl Content="{Binding SelectedDestination}">
          <ContentControl.Style>
            <Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding IsGlobalTabSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
          </ContentControl.Style>
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="{x:Type viewModels:SyncTargetCardViewModel}">
              <StackPanel>
                <Grid Margin="0,22,0,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><StackPanel Orientation="Horizontal"><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding Name}" />
                      <Border Margin="10,1,0,0" Padding="8,3" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="5"
                              Visibility="{Binding ShowKindLabel, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock FontSize="11" Text="{Binding KindLabel}" /></Border>
                      <TextBlock Margin="10,4,0,0" Text="{Binding ReadinessLabel}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        <Style.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style></TextBlock></StackPanel>
                    <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EffectiveFeeds, StringFormat='Effective feeds: {0}'}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding ValidationSummary}" automation:AutomationProperties.LiveSetting="Polite" /></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal"
                                Visibility="{Binding CanDisable, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Text="Enabled" />
                      <CheckBox Style="{StaticResource SyncSwitchStyle}" IsChecked="{Binding IsEnabled}"
                                automation:AutomationProperties.Name="Destination enabled" />
                    </StackPanel>
                    <Button x:Name="DestinationActionsButton" Width="44" MinHeight="38" Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="DestinationActionsButton_Click"
                            automation:AutomationProperties.Name="Destination actions">
                      <controls:AppIcon Kind="More" />
                      <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}">
                        <MenuItem Header="Remove unsupported settings" Command="{Binding RemoveUnsupportedCapabilitiesCommand}"
                                  Visibility="{Binding HasUnsupportedCapabilities, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Style="{StaticResource DarkMenuItemStyle}" />
                        <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" Style="{StaticResource DarkMenuItemStyle}" />
                        <Separator />
                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource DarkMenuItemStyle}" />
                      </ContextMenu></Button.ContextMenu>
                    </Button>
                  </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Connection" /><Border Height="1" Background="{DynamicResource BorderBrush}" />
                <TextBlock Margin="0,10,0,5" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="Endpoint" />
                <TextBox Style="{StaticResource SyncFieldStyle}" Text="{Binding Url, UpdateSourceTrigger=LostFocus}" automation:AutomationProperties.Name="Destination endpoint" />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Authentication" /><Border Height="1" Background="{DynamicResource BorderBrush}" />
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <PasswordBox Style="{StaticResource SyncPasswordStyle}" PasswordChanged="ReplacementToken_PasswordChanged"
                               automation:AutomationProperties.Name="Replacement destination token" />
                  <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ReplaceTokenCommand}" Content="Replace" />
                  <Button Grid.Column="2" MinWidth="76" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearTokenCommand}" Content="Clear" />
                </Grid>
                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TokenStatus}" />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Proxy and transport security" /><Border Height="1" Background="{DynamicResource BorderBrush}" />
                <TextBlock Margin="0,11,0,5" FontWeight="SemiBold" Text="Proxy" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource SegmentButtonStyle}" Content="{Binding InheritanceLabel}" Tag="UseGlobal" Click="ProxySegment_Click" IsChecked="{Binding ProxyChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=UseGlobal}" />
                    <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="No proxy" Tag="NoProxy" Click="ProxySegment_Click" IsChecked="{Binding ProxyChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=NoProxy}" />
                    <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="Custom" Tag="Custom" Click="ProxySegment_Click" IsChecked="{Binding ProxyChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Custom}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SyncFieldStyle}" Text="{Binding ProxyText, UpdateSourceTrigger=LostFocus}"
                           IsEnabled="{Binding IsCustomProxy}" automation:AutomationProperties.Name="Custom destination proxy" />
                </Grid>
                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ProxySummary}" />
                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Verify TLS" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource SegmentButtonStyle}" Content="{Binding InheritanceLabel}" Tag="UseGlobal" Click="BooleanSegment_Click" IsChecked="{Binding VerifySslChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=UseGlobal}" />
                    <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="On" Tag="Enabled" Click="BooleanSegment_Click" IsChecked="{Binding VerifySslChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Enabled}" />
                    <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="Off" Tag="Disabled" Click="BooleanSegment_Click" IsChecked="{Binding VerifySslChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Disabled}" />
                  </StackPanel>
                </Grid>
                <Border Margin="0,12,0,0" Padding="13" Background="{DynamicResource WarningSoftBrush}" CornerRadius="7"
                        Visibility="{Binding EffectiveVerifySsl, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Text="Unsafe TLS acknowledgement" />
                      <TextBlock FontSize="11" Text="Required while effective TLS verification is off." /></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <ToggleButton Style="{StaticResource SegmentButtonStyle}" Content="{Binding InheritanceLabel}" Tag="UseGlobal" Click="UnsafeTlsSegment_Click" IsChecked="{Binding UnsafeTlsChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=UseGlobal}" />
                      <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="Acknowledge" Tag="Enabled" Click="UnsafeTlsSegment_Click" IsChecked="{Binding UnsafeTlsChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Enabled}" />
                      <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="Do not acknowledge" Tag="Disabled" Click="UnsafeTlsSegment_Click" IsChecked="{Binding UnsafeTlsChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Disabled}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <StackPanel Visibility="{Binding ShowTypeSpecificControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Adapter options" /><Border Height="1" Background="{DynamicResource BorderBrush}" />
                  <Grid Margin="0,11,0,0" Visibility="{Binding ShowBattlelogEnrichment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Battle-log enrichment" />
                    <ComboBox Grid.Column="1" Style="{StaticResource SyncComboStyle}" ItemsSource="{Binding BooleanChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BattlelogEnrichmentChoice}" />
                  </Grid>
                  <Grid Margin="0,11,0,0" Visibility="{Binding ShowFleetRuntimeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Fleet runtime mode" />
                    <ComboBox Grid.Column="1" Style="{StaticResource SyncComboStyle}" ItemsSource="{Binding FleetRuntimeModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FleetRuntimeModeChoice}" />
                  </Grid>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Feed overrides" /><Border Height="1" Background="{DynamicResource BorderBrush}" />
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Feeds}">
                  <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type viewModels:SyncTargetFeedViewModel}">
                    <Grid Margin="0,0,0,9"
                          automation:AutomationProperties.Name="{Binding Label, StringFormat='Destination {0} feed override'}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource SegmentButtonStyle}" Content="{Binding InheritanceLabel}" Tag="UseGlobal" Click="FeedSegment_Click" IsChecked="{Binding Choice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=UseGlobal}"
                                      automation:AutomationProperties.Name="{Binding Label, StringFormat='Destination {0} feed override, inherited'}" />
                        <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="On" Tag="Enabled" Click="FeedSegment_Click" IsChecked="{Binding Choice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Enabled}"
                                      automation:AutomationProperties.Name="{Binding Label, StringFormat='Destination {0} feed override, on'}" />
                        <ToggleButton Margin="5,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="Off" Tag="Disabled" Click="FeedSegment_Click" IsChecked="{Binding Choice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Disabled}"
                                      automation:AutomationProperties.Name="{Binding Label, StringFormat='Destination {0} feed override, off'}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EffectiveSummary}" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Effective configuration" /><Border Height="1" Background="{DynamicResource BorderBrush}" />
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding WireContract, StringFormat='Wire contract: {0}'}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AdapterDescription}" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Padding="24,11,24,12" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding PendingChangesText}" />
          <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding OperationStatus}" automation:AutomationProperties.LiveSetting="Polite" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DiscardCommand}" Content="Discard" />
          <Button Command="{Binding SaveCommand}" Content="Save changes" ToolTip="{Binding SaveAvailability}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="2" Panel.ZIndex="100" Background="{DynamicResource DialogBackdropBrush}"
          Visibility="{Binding IsAddWizardOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
          KeyboardNavigation.TabNavigation="Cycle">
      <Border x:Name="WizardDialog" Width="720" MaxHeight="650" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid DataContext="{Binding AddWizard}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel><TextBlock FontSize="21" FontWeight="SemiBold" Text="Add destination" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StepTitle}" /></StackPanel>
          <Grid Grid.Row="1" Margin="0,18,0,18">
            <ItemsControl ItemsSource="{Binding Choices}" Visibility="{Binding IsChooseStep, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type viewModels:SyncAddChoiceViewModel}">
                <Button Margin="0,0,0,6" Padding="12,6" HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding IsAvailable}" Click="WizardChoice_Click" automation:AutomationProperties.Name="{Binding Title}">
                  <Button.Style><Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" /></DataTrigger>
                  </Style.Triggers></Style></Button.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="{Binding Eyebrow}" />
                      <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Margin="0,2,20,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" /></StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Right" FontSize="11" Text="{Binding CapabilitySummary}" />
                      <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource WarningBrush}" Text="{Binding Availability}" /></StackPanel>
                  </Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{Binding IsConfigureStep, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock FontWeight="SemiBold" Text="Display name" /><TextBox Margin="0,5,0,4" Style="{StaticResource SyncFieldStyle}" Text="{Binding Identity, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Destination display name" />
              <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Use 1–64 letters, numbers, hyphens, or underscores. This is also the configuration identity." />
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type viewModels:SyncWizardFieldViewModel}">
                  <StackPanel Margin="0,14,0,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBox Margin="0,5,0,0" Style="{StaticResource SyncFieldStyle}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPlainText, Converter={StaticResource BooleanToVisibilityConverter}}"
                             automation:AutomationProperties.Name="{Binding DisplayName}" />
                    <PasswordBox Margin="0,5,0,0" Style="{StaticResource SyncPasswordStyle}" PasswordChanged="WizardToken_PasswordChanged"
                                 Visibility="{Binding IsSecret, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 automation:AutomationProperties.Name="{Binding DisplayName}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="Proxy and TLS begin with the resolved destination defaults and remain editable after Finish." />
            </StackPanel>
            <Grid Visibility="{Binding IsFeedsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
              <ItemsControl ItemsSource="{Binding Feeds}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type viewModels:SyncWizardFeedViewModel}">
                  <Grid Width="180" Margin="0,0,12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" /><CheckBox Grid.Column="1" Style="{StaticResource SyncSwitchStyle}" IsChecked="{Binding IsEnabled}" />
                  </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Grid.Column="1" Padding="15" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
                <StackPanel><TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="Review" /><TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding ReviewSummary}" />
                  <TextBlock Margin="0,10,0,0" FontSize="12" Text="Finish stages this destination. Nothing is written until Save changes." /></StackPanel>
              </Border>
            </Grid>
          </Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ErrorBrush}" Text="{Binding Error}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Margin="0,0,8,0" Style="{StaticResource QuietButtonStyle}" Command="{Binding CancelCommand}" Content="Cancel" />
              <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BackCommand}" Content="Back" Click="WizardStep_Click" />
              <Button Command="{Binding NextCommand}" Content="Next" Click="WizardStep_Click" Visibility="{Binding IsLastStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
              <Button Command="{Binding FinishCommand}" Content="Finish" Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
