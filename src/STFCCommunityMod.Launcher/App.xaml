<Application x:Class="STFCCommunityMod.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <FontFamily x:Key="LauncherTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Shared shell geometry: shape follows component role, not page ownership. -->
    <sys:Double x:Key="SettingsInputWidthSmall">96</sys:Double>
    <sys:Double x:Key="SettingsInputWidthMedium">144</sys:Double>
    <sys:Double x:Key="SettingsInputWidthLarge">220</sys:Double>
    <sys:Double x:Key="SettingsNumericInputWidthCompact">84</sys:Double>
    <sys:Double x:Key="SettingsNumericInputWidthStandard">112</sys:Double>
    <sys:Double x:Key="SettingsNumericInputWidthWide">144</sys:Double>
    <sys:Double x:Key="SettingsNumericSliderWidth">176</sys:Double>
    <sys:Double x:Key="SettingsNumericUnitWidth">40</sys:Double>
    <sys:Double x:Key="SettingsRowPrimaryActionWidth">44</sys:Double>
    <GridLength x:Key="SettingsNumericUnitColumnWidth">40</GridLength>
    <GridLength x:Key="SettingsRowPrimaryActionColumnWidth">44</GridLength>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">3</CornerRadius>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="SectionDividerThickness">0,0,0,1</Thickness>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0C1421" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#172233" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#202E43" />
    <SolidColorBrush x:Key="NavigationBrush" Color="#101C2E" />
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#213D5E" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3C3DA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#35455E" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#60738E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#145A9F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1969B7" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#73B9FF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="QuietHoverBrush" Color="#202E43" />
    <SolidColorBrush x:Key="FocusOuterBrush" Color="#F1F5FC" />
    <SolidColorBrush x:Key="FocusInnerBrush" Color="#0C1421" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#82D8B3" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#183B35" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F4CF8A" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3B3021" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFA1AF" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3C2025" />
    <SolidColorBrush x:Key="DialogBackdropBrush" Color="#B3000000" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style>
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <Border BorderBrush="{DynamicResource FocusOuterBrush}"
                          BorderThickness="2"
                          CornerRadius="6">
                    <Border Margin="2"
                            BorderBrush="{DynamicResource FocusInnerBrush}"
                            BorderThickness="2"
                            CornerRadius="4" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle"
           BasedOn="{StaticResource {x:Type Button}}"
           TargetType="Button">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="ShellButtonTextStyle"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
      <Setter Property="FontSize"
              Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
      <Setter Property="FontWeight"
              Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource QuietHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="QuietButtonStyle"
           BasedOn="{StaticResource SecondaryButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="UtilityActionButtonStyle"
           BasedOn="{StaticResource SecondaryButtonStyle}"
           TargetType="Button">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Profile-first shell roles mirror the design preview without changing action semantics. -->
    <Style x:Key="ShellNavigationButtonStyle"
           BasedOn="{StaticResource SecondaryButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ShellSelectedNavigationButtonStyle"
           BasedOn="{StaticResource ShellNavigationButtonStyle}"
           TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource NavigationSelectedBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="ShellLinkButtonStyle"
           BasedOn="{StaticResource ShellNavigationButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0,7" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style x:Key="ProfileCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="20" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="ProfileBadgeStyle" TargetType="Border">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="PageTitleStyle"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="TextBlock">
      <Setter Property="FontSize" Value="27" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="ProfileNameStyle"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style x:Key="MutedBodyStyle"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="56" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle"
           BasedOn="{StaticResource CaptionButtonStyle}"
           TargetType="Button">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Setter Property="Background" Value="#C42B1C" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Setter Property="Background" Value="#C42B1C" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="InAppDialogStyle" TargetType="{x:Type controls:InAppDialog}">
      <Setter Property="Panel.ZIndex" Value="100" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type controls:InAppDialog}">
            <Grid Background="{DynamicResource DialogBackdropBrush}"
                  KeyboardNavigation.ControlTabNavigation="Cycle"
                  KeyboardNavigation.DirectionalNavigation="Contained"
                  KeyboardNavigation.TabNavigation="Cycle">
              <Border MaxWidth="{TemplateBinding DialogWidth}"
                      MaxHeight="{TemplateBinding DialogMaxHeight}"
                      Margin="20"
                      Padding="26"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource DialogCornerRadius}"
                      KeyboardNavigation.TabNavigation="Cycle">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock FontSize="21"
                             FontWeight="SemiBold"
                             Text="{TemplateBinding DialogTitle}" />
                  <ContentPresenter Grid.Row="1"
                                     Margin="0,18,0,0"
                                     VerticalAlignment="Stretch"
                                     Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                  <Button x:Name="PART_CloseButton"
                          Grid.Row="2"
                          Margin="0,24,0,0"
                          HorizontalAlignment="Right"
                          Style="{StaticResource UtilityActionButtonStyle}"
                          Content="_Close"
                          automation:AutomationProperties.Name="Close dialog" />
                </Grid>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsOpen" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
