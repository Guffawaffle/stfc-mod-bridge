<Application x:Class="STFCCommunityMod.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <FontFamily x:Key="LauncherTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111B2C" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#172337" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B7CA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3950" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#60738E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0B70C9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A68B8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="QuietHoverBrush" Color="#223149" />
    <SolidColorBrush x:Key="FocusOuterBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="FocusInnerBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#57D17C" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#183A2A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F6BE4F" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2F18" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7070" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3C2025" />
    <SolidColorBrush x:Key="DialogBackdropBrush" Color="#B3000000" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style>
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <Border BorderBrush="{DynamicResource FocusOuterBrush}"
                          BorderThickness="2"
                          CornerRadius="6">
                    <Border Margin="2"
                            BorderBrush="{DynamicResource FocusInnerBrush}"
                            BorderThickness="2"
                            CornerRadius="4" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource QuietHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietButtonStyle"
           BasedOn="{StaticResource SecondaryButtonStyle}"
           TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="UtilityActionButtonStyle"
           BasedOn="{StaticResource SecondaryButtonStyle}"
           TargetType="Button">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="56" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle"
           BasedOn="{StaticResource CaptionButtonStyle}"
           TargetType="Button">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Setter Property="Background" Value="#C42B1C" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Setter Property="Background" Value="#C42B1C" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="InAppDialogStyle" TargetType="{x:Type controls:InAppDialog}">
      <Setter Property="Panel.ZIndex" Value="100" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type controls:InAppDialog}">
            <Grid Background="{DynamicResource DialogBackdropBrush}">
              <Border Width="440"
                      MaxWidth="440"
                      Padding="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14"
                      KeyboardNavigation.TabNavigation="Cycle">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock FontSize="21"
                             FontWeight="SemiBold"
                             Text="{TemplateBinding DialogTitle}" />
                  <ContentPresenter Grid.Row="1"
                                    Margin="0,18,0,0"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                  <Button x:Name="PART_CloseButton"
                          Grid.Row="2"
                          Margin="0,24,0,0"
                          HorizontalAlignment="Right"
                          Style="{StaticResource UtilityActionButtonStyle}"
                          Content="_Close"
                          automation:AutomationProperties.Name="Close dialog" />
                </Grid>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsOpen" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
