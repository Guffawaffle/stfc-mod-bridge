<UserControl x:Class="STFCCommunityMod.Launcher.Controls.HelpFlyoutButton"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="False"
             Unloaded="HelpFlyoutButton_Unloaded"
             automation:AutomationProperties.Name="{Binding AutomationName, ElementName=Root}"
             automation:AutomationProperties.HelpText="{Binding HelpText, ElementName=Root}">
  <Grid>
    <Button x:Name="FlyoutButton"
            Width="32"
            Height="32"
            MinHeight="32"
            Padding="0"
            Style="{StaticResource QuietButtonStyle}"
            Click="FlyoutButton_Click"
            GotKeyboardFocus="FlyoutButton_GotKeyboardFocus"
            LostKeyboardFocus="FlyoutButton_LostKeyboardFocus"
            MouseEnter="FlyoutSurface_MouseEnter"
            MouseLeave="FlyoutSurface_MouseLeave"
            PreviewKeyDown="FlyoutSurface_PreviewKeyDown"
            automation:AutomationProperties.Name="{Binding AutomationName, ElementName=Root}"
            automation:AutomationProperties.HelpText="{Binding HelpText, ElementName=Root}">
      <Border Width="18"
              Height="18"
              BorderThickness="1.5"
              CornerRadius="9">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPinned, ElementName=Root}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Text="?"
                   TextAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned, ElementName=Root}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
    </Button>

    <Popup x:Name="Flyout"
           PlacementTarget="{Binding ElementName=FlyoutButton}"
           Placement="Bottom"
           HorizontalOffset="-12"
           AllowsTransparency="True"
           StaysOpen="True"
           Closed="Flyout_Closed"
           PopupAnimation="Fade">
      <Border x:Name="FlyoutContent"
              MaxWidth="360"
              Margin="4"
              Padding="12,9"
              Background="{DynamicResource SurfaceMutedBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="{StaticResource ControlBorderThickness}"
              CornerRadius="{StaticResource PopupCornerRadius}"
              MouseEnter="FlyoutSurface_MouseEnter"
              MouseLeave="FlyoutSurface_MouseLeave"
              PreviewKeyDown="FlyoutSurface_PreviewKeyDown"
              automation:AutomationProperties.Name="{Binding AutomationName, ElementName=Root}">
        <TextBlock FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="{Binding HelpText, ElementName=Root}"
                   TextWrapping="Wrap" />
      </Border>
    </Popup>
  </Grid>
</UserControl>
