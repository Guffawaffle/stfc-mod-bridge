<UserControl x:Class="STFCCommunityMod.Launcher.Controls.LaunchTargetSplitButton"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinHeight="44"
             automation:AutomationProperties.Name="Game launch target">
  <UserControl.Resources>
    <Style x:Key="SplitButtonSegmentStyle"
           BasedOn="{StaticResource {x:Type Button}}"
           TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="SegmentBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SegmentBorder"
                        Property="Background"
                        Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="SegmentBorder" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="44" />
    </Grid.ColumnDefinitions>

    <Button x:Name="PrimaryButton"
            MinWidth="150"
            MinHeight="44"
            Padding="16,8"
            Tag="6,0,0,6"
            HorizontalContentAlignment="Left"
            Style="{StaticResource SplitButtonSegmentStyle}"
            Command="{Binding PrimaryCommand, ElementName=Root}"
            Content="{Binding PrimaryLabel, ElementName=Root}"
            IsEnabled="{Binding IsPrimaryEnabled, ElementName=Root}"
            ToolTip="{Binding PrimaryAutomationName, ElementName=Root}"
            ToolTipService.ShowOnDisabled="True"
            automation:AutomationProperties.Name="{Binding PrimaryAutomationName, ElementName=Root}"
            automation:AutomationProperties.HelpText="Executes the selected game launch target." />

    <Button x:Name="MenuButton"
            Grid.Column="1"
            MinWidth="44"
            Width="44"
            MinHeight="44"
            Margin="-1,0,0,0"
            Padding="0"
            Tag="0,6,6,0"
            Style="{StaticResource SplitButtonSegmentStyle}"
            Click="MenuButton_Click"
            IsEnabled="{Binding IsMenuEnabled, ElementName=Root}"
            automation:AutomationProperties.Name="Choose game launch target"
            automation:AutomationProperties.HelpText="Opens the launch target menu without launching anything.">
      <TextBlock FontFamily="Segoe UI Symbol"
                 FontSize="13"
                 Text="⌄" />
    </Button>

    <Popup x:Name="ChoicePopup"
           AllowsTransparency="True"
           Closed="ChoicePopup_Closed"
           Placement="Bottom"
           PlacementTarget="{Binding ElementName=Root}"
           PopupAnimation="Fade"
           StaysOpen="False">
      <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
              Margin="0,4,0,0"
              Padding="4"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource PopupCornerRadius}"
              PreviewKeyDown="ChoicePopup_PreviewKeyDown">
        <StackPanel KeyboardNavigation.TabNavigation="Cycle">
          <Button x:Name="PrimeChoiceButton"
                  MinHeight="44"
                  Padding="12,8"
                  HorizontalContentAlignment="Stretch"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding SelectPrimeCommand, ElementName=Root}"
                  Click="ChoiceButton_Click"
                  automation:AutomationProperties.Name="{Binding PrimeChoiceAutomationName, ElementName=Root}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="✓"
                         Visibility="{Binding IsPrimeSelected, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                         automation:AutomationProperties.Name="Selected" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Launch prime.exe" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding PrimeChoiceStatus, ElementName=Root}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button x:Name="ScopelyChoiceButton"
                  MinHeight="44"
                  Padding="12,8"
                  HorizontalContentAlignment="Stretch"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding SelectScopelyCommand, ElementName=Root}"
                  Click="ChoiceButton_Click"
                  automation:AutomationProperties.Name="{Binding ScopelyChoiceAutomationName, ElementName=Root}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="✓"
                         Visibility="{Binding IsScopelySelected, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                         automation:AutomationProperties.Name="Selected" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Open Scopely launcher" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding ScopelyChoiceStatus, ElementName=Root}" />
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
