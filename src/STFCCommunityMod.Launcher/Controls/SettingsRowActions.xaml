<UserControl x:Class="STFCCommunityMod.Launcher.Controls.SettingsRowActions"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
             Focusable="False">
  <UserControl.Resources>
    <Style x:Key="RowMenuActionStyle"
           BasedOn="{StaticResource QuietButtonStyle}"
           TargetType="Button">
      <Setter Property="MinWidth" Value="280" />
      <Setter Property="Height" Value="42" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CaptureActionStyle"
           BasedOn="{StaticResource SecondaryButtonStyle}"
           TargetType="controls:KeybindingCaptureButton">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal">
    <controls:HelpFlyoutButton HelpText="{Binding DefaultAndEffectiveHelp}"
                               AutomationName="{Binding DefaultAndEffectiveAutomationName}" />

    <Button Width="44"
            Height="44"
            MinHeight="44"
            Padding="0"
            Style="{StaticResource QuietButtonStyle}"
            Command="{Binding RevertDraftCommand}"
            ToolTip="{Binding RevertDraftAvailability}"
            Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
            automation:AutomationProperties.Name="{Binding RevertDraftAutomationName}"
            automation:AutomationProperties.HelpText="{Binding RevertDraftAutomationHelp}">
      <controls:AppIcon Kind="RevertDraft" />
    </Button>

    <Button MinWidth="72"
            Height="44"
            MinHeight="44"
            Margin="4,0,0,0"
            Padding="0"
            Style="{StaticResource QuietButtonStyle}"
            Command="{Binding UseDefaultCommand}"
            ToolTip="{Binding UseDefaultAvailability}"
            Visibility="{Binding DraftHasOverride, Converter={StaticResource BooleanToVisibilityConverter}}"
            automation:AutomationProperties.Name="{Binding Title, StringFormat=Reset {0} to default}"
            automation:AutomationProperties.HelpText="{Binding UseDefaultAvailability}">
      <AccessText FontSize="12"
                  Text="_Default" />
    </Button>

    <Button x:Name="MoreActionsButton"
            Width="44"
            Height="44"
            MinHeight="44"
            Margin="4,0,0,0"
            Padding="0"
            Style="{StaticResource QuietButtonStyle}"
            Click="MoreActionsButton_Click"
            ToolTip="More actions"
            Visibility="{Binding HasOverflowActions, Converter={StaticResource BooleanToVisibilityConverter}}"
            automation:AutomationProperties.Name="{Binding Title, StringFormat=More actions for {0}}"
            automation:AutomationProperties.HelpText="Opens additional actions for this setting.">
      <controls:AppIcon Kind="More" />
    </Button>

    <Popup x:Name="ActionPopup"
           PlacementTarget="{Binding ElementName=MoreActionsButton}"
           Placement="Bottom"
           HorizontalOffset="-236"
           AllowsTransparency="True"
           StaysOpen="False"
           PopupAnimation="Fade">
      <Border Margin="4"
              Padding="4"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              PreviewKeyDown="ActionPopup_PreviewKeyDown"
              DataContext="{Binding DataContext, ElementName=Root}">
        <StackPanel>
          <Button x:Name="AddBindingAction"
                  Style="{StaticResource RowMenuActionStyle}"
                  Click="AddBinding_Click"
                  Visibility="{Binding IsKeybindingEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTip="Capture another keyboard key or mouse button"
                  automation:AutomationProperties.Name="{Binding Title, StringFormat=Add a binding for {0}}"
                  automation:AutomationProperties.HelpText="Opens a focused popup that captures the next key or mouse button.">
            <StackPanel Orientation="Horizontal">
              <controls:AppIcon Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                Kind="Add" />
              <TextBlock VerticalAlignment="Center"
                         Text="Add binding" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="CapturePopup"
           PlacementTarget="{Binding ElementName=MoreActionsButton}"
           Placement="Bottom"
           HorizontalOffset="-276"
           AllowsTransparency="True"
           StaysOpen="False"
           Closed="CapturePopup_Closed"
           PopupAnimation="Fade">
      <Border Width="320"
              Margin="4"
              Padding="16"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              DataContext="{Binding DataContext, ElementName=Root}">
        <StackPanel>
          <TextBlock FontSize="15"
                     FontWeight="SemiBold"
                     Text="Add binding" />
          <TextBlock Margin="0,5,0,14"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Press a keyboard key or mouse button. Escape cancels."
                     TextWrapping="Wrap" />
          <controls:KeybindingCaptureButton x:Name="CaptureButton"
                                            Style="{StaticResource CaptureActionStyle}"
                                            Prompt="Listening…"
                                            CapturedCommand="{Binding AddKeybindingCommand}"
                                            IsEnabled="{Binding CanEdit}"
                                            CaptureFinished="CaptureButton_CaptureFinished"
                                            automation:AutomationProperties.Name="{Binding Title, StringFormat=Capture a new binding for {0}}"
                                            automation:AutomationProperties.HelpText="Press a keyboard key or mouse button. Escape cancels." />
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>
</UserControl>
