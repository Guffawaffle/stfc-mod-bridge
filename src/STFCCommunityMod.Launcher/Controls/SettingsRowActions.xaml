<UserControl x:Class="STFCCommunityMod.Launcher.Controls.SettingsRowActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
             Focusable="False">
  <UserControl.Resources>
    <Style TargetType="ContextMenu">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource FocusOuterBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal">
    <Button Width="44"
            Height="44"
            MinHeight="44"
            Padding="0"
            Style="{StaticResource QuietButtonStyle}"
            Command="{Binding RevertDraftCommand}"
            ToolTip="{Binding RevertDraftAvailability}"
            Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
            automation:AutomationProperties.Name="{Binding RevertDraftAutomationName}"
            automation:AutomationProperties.HelpText="{Binding RevertDraftAutomationHelp}">
      <controls:AppIcon Kind="RevertDraft" />
    </Button>

    <controls:OverflowMenuButton Width="44"
                                 Height="44"
                                 MinHeight="44"
                                 Margin="4,0,0,0"
                                 Padding="0"
                                 Style="{StaticResource QuietButtonStyle}"
                                 ToolTip="More setting actions"
                                 automation:AutomationProperties.Name="{Binding Title, StringFormat=More actions for {0}}"
                                 automation:AutomationProperties.HelpText="Includes the command to clear the explicit override and use the application default.">
      <controls:AppIcon Kind="More" />
      <controls:OverflowMenuButton.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="{Binding UseDefaultLabel}"
                    Command="{Binding UseDefaultCommand}"
                    ToolTip="{Binding UseDefaultAvailability}"
                    automation:AutomationProperties.Name="{Binding UseDefaultLabel}"
                    automation:AutomationProperties.HelpText="{Binding UseDefaultAvailability}" />
        </ContextMenu>
      </controls:OverflowMenuButton.ContextMenu>
    </controls:OverflowMenuButton>
  </StackPanel>
</UserControl>
