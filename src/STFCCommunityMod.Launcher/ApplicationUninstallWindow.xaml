<Window x:Class="STFCCommunityMod.Launcher.ApplicationUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Uninstall STFC Mod Bridge"
        Width="680"
        Height="560"
        MinWidth="600"
        MinHeight="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/stfc-community-mod.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        automation:AutomationProperties.Name="Uninstall STFC Mod Bridge">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="46" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="22,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="STFC Mod Bridge" />
        <Button Grid.Column="1"
                Style="{StaticResource CloseCaptionButtonStyle}"
                Click="CancelButton_Click"
                Content="&#xE8BB;"
                FontFamily="Segoe MDL2 Assets"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Close uninstall" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="34,30,34,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="26"
                   FontWeight="SemiBold"
                   Text="Uninstall STFC Mod Bridge?" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="This removes the application for your Windows account. Administrator privileges are not required."
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Margin="0,22,0,0"
                Padding="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Application files" />
            <TextBlock x:Name="ProgramDirectoryText"
                       Margin="0,4,0,0"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0"
                       FontWeight="SemiBold"
                       Text="Local data" />
            <TextBlock x:Name="StateDirectoryText"
                       Margin="0,4,0,0"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="14"
                Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
          <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                     Text="Your installed Community Mod, game files, and Community Mod TOML will not be changed. Remove the mod separately in Mod Bridge before uninstalling the application if that is what you intend."
                     TextWrapping="Wrap" />
        </Border>

        <CheckBox x:Name="RemoveStateCheckBox"
                  Grid.Row="4"
                  Margin="0,18,0,0"
                  Padding="2"
                  HorizontalAlignment="Left"
                  VerticalContentAlignment="Center"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Content="Also remove Mod Bridge preferences, journals, rollback data, and configuration backups"
                  IsChecked="False"
                  automation:AutomationProperties.Name="Also remove Mod Bridge local data" />

        <Grid Grid.Row="5" Margin="0,28,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="1"
                  MinWidth="110"
                  Margin="0,0,10,0"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Click="CancelButton_Click"
                  Content="_Cancel"
                  IsCancel="True"
                  automation:AutomationProperties.Name="Cancel uninstall" />
          <Button Grid.Column="2"
                  MinWidth="150"
                  Click="UninstallButton_Click"
                  Content="_Uninstall"
                  IsDefault="True"
                  automation:AutomationProperties.Name="Uninstall STFC Mod Bridge" />
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
