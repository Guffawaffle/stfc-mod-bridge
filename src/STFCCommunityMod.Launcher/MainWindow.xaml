<Window x:Class="STFCCommunityMod.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
        xmlns:core="clr-namespace:STFCCommunityMod.Launcher.Core;assembly=STFCCommunityMod.Launcher.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:STFCCommunityMod.Launcher.Views"
        Title="STFC Community Mod Launcher"
        Width="680"
        Height="680"
        MinWidth="560"
        MinHeight="620"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/stfc-community-mod.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        automation:AutomationProperties.Name="STFC Community Mod Launcher">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="TitleBarColorModeItemStyle"
           TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="automation:AutomationProperties.Name"
              Value="{Binding Label}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface"
                        Property="Background"
                        Value="{DynamicResource QuietHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="TitleBarColorModeItemTemplate">
      <Grid MinWidth="116">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="22" />
        </Grid.ColumnDefinitions>
        <controls:AppIcon Width="18"
                          Height="18"
                          VerticalAlignment="Center"
                          FontSize="18"
                          Kind="{Binding Icon}" />
        <TextBlock Grid.Column="1"
                   Margin="8,0"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Text="{Binding Label}" />
        <controls:AppIcon Grid.Column="2"
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center"
                          FontSize="16"
                          Kind="Checkmark">
          <controls:AppIcon.Style>
            <Style TargetType="controls:AppIcon">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                             Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:AppIcon.Style>
        </controls:AppIcon>
      </Grid>
    </DataTemplate>

    <Style x:Key="TitleBarColorModeComboBoxStyle"
           TargetType="ComboBox">
      <Setter Property="MinWidth" Value="142" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource LauncherTextFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource TitleBarColorModeItemStyle}" />
      <Setter Property="ItemTemplate" Value="{StaticResource TitleBarColorModeItemTemplate}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ControlSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1"
                              Width="10"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1,1 L 5,5 L 9,1"
                              Stretch="None"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.5" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ControlSurface"
                                Property="Background"
                                Value="{DynamicResource QuietHoverBrush}" />
                        <Setter TargetName="ControlSurface"
                                Property="BorderBrush"
                                Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ControlSurface"
                                Property="BorderBrush"
                                Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="10,0,32,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

              <Border x:Name="KeyboardFocusBorder"
                      BorderBrush="{DynamicResource FocusOuterBrush}"
                      BorderThickness="2"
                      CornerRadius="8"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PlacementTarget="{Binding ElementName=DropDownToggle}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,4,0,0"
                        Padding="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                  <ScrollViewer CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="KeyboardFocusBorder"
                        Property="Visibility"
                        Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Margin="24,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="196" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="HomeSettingsTitleBarButton"
                Grid.Column="0"
                Padding="10,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{StaticResource QuietButtonStyle}"
                Click="SettingsNavigationButton_Click"
                ToolTip="Open launcher settings"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Open launcher settings"
                automation:AutomationProperties.HelpText="Open configuration, notification, hotkey, and launcher settings.">
          <StackPanel Orientation="Horizontal">
            <controls:AppIcon Width="18"
                              Height="18"
                              VerticalAlignment="Center"
                              FontSize="18"
                              Kind="Settings" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="Settings" />
          </StackPanel>
        </Button>

        <Button x:Name="SettingsHomeTitleBarButton"
                Grid.Column="0"
                Padding="10,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{StaticResource QuietButtonStyle}"
                Command="{Binding DataContext.NavigateHomeCommand, ElementName=SettingsWorkspace}"
                ToolTip="Return to launcher home"
                Visibility="Collapsed"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Return to launcher home"
                automation:AutomationProperties.HelpText="Return to the launcher home screen.">
          <StackPanel Orientation="Horizontal">
            <controls:AppIcon Width="18"
                              Height="18"
                              VerticalAlignment="Center"
                              FontSize="18"
                              Kind="Back" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="Home" />
          </StackPanel>
        </Button>

        <Border Grid.Column="1"
                Width="1"
                Height="28"
                VerticalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />

        <TextBlock Grid.Column="2"
                   Margin="24,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="STFC Community Mod" />

        <Button Grid.Column="3"
                Margin="16,0,0,0"
                Padding="10,6"
                VerticalAlignment="Center"
                Style="{StaticResource QuietButtonStyle}"
                Click="DiagnosticsButton_Click"
                Content="Diagnostics"
                ToolTip="Preview redacted launcher diagnostics"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Open redacted launcher diagnostics"
                automation:AutomationProperties.HelpText="Preview health and redacted support information. Diagnostics are never uploaded automatically." />
      </Grid>

      <Button x:Name="SettingsSearchToggleButton"
              Grid.Column="1"
              Width="44"
              MinWidth="44"
              Margin="0,0,6,0"
              Padding="0"
              VerticalAlignment="Center"
              Style="{StaticResource UtilityActionButtonStyle}"
              Command="{Binding DataContext.SearchToggleCommand, ElementName=SettingsWorkspace}"
              Click="SettingsSearchToggleButton_Click"
              ToolTip="{Binding DataContext.SearchToggleHelp, ElementName=SettingsWorkspace}"
              Visibility="Collapsed"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              automation:AutomationProperties.Name="{Binding DataContext.SearchToggleHelp, ElementName=SettingsWorkspace}"
              automation:AutomationProperties.HelpText="Search every setting by name, description, category, or canonical key.">
        <Grid Width="18" Height="18">
          <controls:AppIcon Width="18"
                            Height="18"
                            FontSize="18"
                            Kind="Search">
            <controls:AppIcon.Style>
              <Style TargetType="controls:AppIcon">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.IsSearchVisible, ElementName=SettingsWorkspace}"
                               Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:AppIcon.Style>
          </controls:AppIcon>
          <controls:AppIcon Width="18"
                            Height="18"
                            FontSize="18"
                            Kind="Remove">
            <controls:AppIcon.Style>
              <Style TargetType="controls:AppIcon">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.IsSearchVisible, ElementName=SettingsWorkspace}"
                               Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:AppIcon.Style>
          </controls:AppIcon>
        </Grid>
      </Button>

      <ComboBox x:Name="ColorModeSelector"
                Grid.Column="2"
                Margin="4,0,4,0"
                VerticalAlignment="Center"
                Style="{StaticResource TitleBarColorModeComboBoxStyle}"
                SelectedValuePath="Mode"
                SelectionChanged="ColorModeSelector_SelectionChanged"
                ToolTip="Choose how the launcher follows light and dark appearance."
                Visibility="Collapsed"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Launcher color mode"
                automation:AutomationProperties.HelpText="Choose System, Light, or Dark. System follows the Windows app theme." />
      <StackPanel Grid.Column="3"
                  Orientation="Horizontal">
        <Button Style="{StaticResource CaptionButtonStyle}"
                Click="MinimizeButton_Click"
                ToolTip="Minimize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Minimize launcher">
          <Viewbox Width="12"
                   Height="12">
            <Grid Width="12"
                  Height="12">
              <Path Data="M 1,6 L 11,6"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2"
                    StrokeStartLineCap="Square"
                    StrokeEndLineCap="Square" />
            </Grid>
          </Viewbox>
        </Button>
        <Button x:Name="MaximizeRestoreButton"
                Style="{StaticResource CaptionButtonStyle}"
                Click="MaximizeRestoreButton_Click"
                ToolTip="Maximize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Maximize launcher">
          <Viewbox Width="12"
                   Height="12">
            <Grid Width="12"
                  Height="12">
              <Path x:Name="MaximizeGlyph"
                    Data="M 1.5,1.5 L 10.5,1.5 L 10.5,10.5 L 1.5,10.5 Z"
                    Fill="Transparent"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2" />
              <Path x:Name="RestoreGlyph"
                    Data="M 3.5,1.5 L 10.5,1.5 L 10.5,8.5 M 8.5,3.5 L 1.5,3.5 L 1.5,10.5 L 8.5,10.5 Z"
                    Fill="Transparent"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2"
                    Visibility="Collapsed" />
            </Grid>
          </Viewbox>
        </Button>
        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                Click="CloseButton_Click"
                ToolTip="Close"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Close launcher">
          <Viewbox Width="12"
                   Height="12">
            <Grid Width="12"
                  Height="12">
              <Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2"
                    StrokeStartLineCap="Square"
                    StrokeEndLineCap="Square" />
            </Grid>
          </Viewbox>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="0"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{DynamicResource BorderBrush}" />

    <StackPanel x:Name="HomeWorkspace"
                Grid.Row="1"
                Width="520"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center"
                 FontSize="32"
                 FontWeight="SemiBold"
                 Text="Make STFC yours."
                 TextAlignment="Center" />
      <TextBlock Margin="24,10,24,0"
                 HorizontalAlignment="Center"
                 FontSize="15"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Install, update, and configure the community mod in one place."
                 TextAlignment="Center" />

      <Border Margin="0,30,0,0"
              Padding="22,6"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="1" />
            <RowDefinition Height="76" />
            <RowDefinition Height="1" />
            <RowDefinition Height="76" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0"
                  Width="34"
                  Height="34"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  CornerRadius="17">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameFolderTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameFolderTone}"
                               Value="{x:Static core:LauncherHomeTone.Error}">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="{Binding GameFolderIcon}"
                       TextAlignment="Center"
                       automation:AutomationProperties.Name="{Binding GameFolderStatusAutomationName}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="Game folder" />

          <StackPanel Grid.Row="0"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <TextBlock Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding GameFolderStatus}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource QuietButtonStyle}"
                    Click="ChooseGameFolderButton_Click"
                    Content="{Binding GameFolderActionLabel}"
                    automation:AutomationProperties.Name="{Binding GameFolderActionAutomationName}" />
          </StackPanel>

          <Border Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Background="{DynamicResource BorderBrush}" />

          <Border Grid.Row="2"
                  Width="34"
                  Height="34"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  CornerRadius="17">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Bold"
                       Text="{Binding GameClientIcon}"
                       TextAlignment="Center"
                       automation:AutomationProperties.Name="{Binding GameClientStatusAutomationName}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Warning}">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="Game client" />
          <StackPanel Grid.Row="2"
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <TextBlock Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Text="{Binding GameClientStatus}"
                       TextAlignment="Right">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Warning}">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource QuietButtonStyle}"
                    Click="LaunchGameButton_Click"
                    Content="{Binding LaunchActionLabel}"
                    IsEnabled="{Binding CanLaunchGame}"
                    automation:AutomationProperties.Name="{Binding LaunchActionAutomationName}"
                    automation:AutomationProperties.HelpText="Launches the modded game through the official Star Trek Fleet Command launcher. Authentication and game updates remain official-launcher responsibilities." />
          </StackPanel>

          <Border Grid.Row="3"
                  Grid.ColumnSpan="3"
                  Background="{DynamicResource BorderBrush}" />

          <Border Grid.Row="4"
                  Width="34"
                  Height="34"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  CornerRadius="17">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ModTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ModTone}"
                               Value="{x:Static core:LauncherHomeTone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ModTone}"
                               Value="{x:Static core:LauncherHomeTone.Error}">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="Bold"
                       Text="MOD"
                       TextAlignment="Center"
                       automation:AutomationProperties.Name="Community mod status">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ModTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ModTone}"
                                 Value="{x:Static core:LauncherHomeTone.Warning}">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ModTone}"
                                 Value="{x:Static core:LauncherHomeTone.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <TextBlock Grid.Row="4"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="Community mod" />

          <StackPanel Grid.Row="4"
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <TextBlock Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding ModStatus}"
                       automation:AutomationProperties.LiveSetting="Polite" />
            <Button Style="{StaticResource QuietButtonStyle}"
                    Click="ModActionButton_Click"
                    Content="{Binding ModActionLabel}"
                    IsEnabled="{Binding CanManageMod}"
                    automation:AutomationProperties.Name="{Binding ModActionAutomationName}"
                    automation:AutomationProperties.HelpText="Downloads and verifies the selected community mod release before asking for confirmation." />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,14,0,0"
              Padding="12,9"
              Background="{DynamicResource SurfaceMutedBrush}"
              CornerRadius="8"
              Visibility="{Binding HasSelectionFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding SelectionFeedback}"
                   TextAlignment="Center"
                   automation:AutomationProperties.LiveSetting="Polite" />
      </Border>

      <Border Margin="0,8,0,0"
              Padding="12,9"
              Background="{DynamicResource SurfaceMutedBrush}"
              CornerRadius="8"
              Visibility="{Binding HasHomeOperationFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding HomeOperationFeedback}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />
      </Border>
    </StackPanel>

    <views:SettingsView x:Name="SettingsWorkspace"
                        Grid.Row="1"
                        Margin="20,0,20,12"
                        Visibility="Collapsed" />

    <controls:InAppDialog x:Name="ModOperationDialog"
                          Grid.RowSpan="2"
                          Style="{StaticResource InAppDialogStyle}"
                          DialogTitle="Install community mod?"
                          automation:AutomationProperties.Name="Community mod confirmation dialog">
      <StackPanel>
        <TextBlock x:Name="ModOperationSummary"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,14,0,0"
                   FontWeight="SemiBold"
                   Text="Exact game target" />
        <TextBlock x:Name="ModOperationTarget"
                   Margin="0,4,0,0"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="The download must match the release size and SHA-256, pass Authenticode for Joseph Gustavson, and report the expected embedded version. The game must remain closed."
                   TextWrapping="Wrap" />
        <Button x:Name="ConfirmModOperationButton"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource UtilityActionButtonStyle}"
                Click="ConfirmModOperationButton_Click"
                Content="_Install"
                automation:AutomationProperties.Name="Confirm community mod installation" />
      </StackPanel>
    </controls:InAppDialog>

    <controls:InAppDialog x:Name="DiagnosticsDialog"
                          Grid.RowSpan="2"
                          Style="{StaticResource InAppDialogStyle}"
                          DialogTitle="Launcher diagnostics"
                          automation:AutomationProperties.Name="Redacted launcher diagnostics dialog">
      <StackPanel Width="388">
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Preview before copying or exporting. Paths, tokens, cookies, and endpoints are redacted. Nothing is uploaded automatically."
                   TextWrapping="Wrap" />
        <TextBox x:Name="DiagnosticPreviewText"
                 Height="300"
                 Margin="0,14,0,0"
                 Padding="10"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="11"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 automation:AutomationProperties.Name="Redacted diagnostic preview" />
        <TextBlock x:Name="DiagnosticExportStatus"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Margin="0,16,0,0"
                   HorizontalAlignment="Right">
          <Button Margin="0,0,8,8"
                  Style="{StaticResource QuietButtonStyle}"
                  Click="CopyDiagnosticsButton_Click"
                  Content="_Copy preview"
                  automation:AutomationProperties.Name="Copy redacted diagnostics" />
          <Button Margin="0,0,8,8"
                  Style="{StaticResource QuietButtonStyle}"
                  Click="ExportDiagnosticsButton_Click"
                  Content="_Export JSON…"
                  automation:AutomationProperties.Name="Export redacted diagnostics JSON" />
          <Button x:Name="DiagnosticsRecoverButton"
                  Margin="0,0,8,8"
                  Style="{StaticResource QuietButtonStyle}"
                  Click="DiagnosticsRecoverButton_Click"
                  Content="_Recover"
                  automation:AutomationProperties.Name="Recover incomplete mod transaction" />
          <Button x:Name="DiagnosticsUninstallButton"
                  Margin="0,0,0,8"
                  Style="{StaticResource QuietButtonStyle}"
                  Click="DiagnosticsUninstallButton_Click"
                  Content="Remove _mod"
                  automation:AutomationProperties.Name="Remove launcher-managed community mod" />
          <Button Margin="0,0,0,8"
                  Style="{StaticResource QuietButtonStyle}"
                  Click="CheckLauncherUpdateButton_Click"
                  Content="Check launcher _update"
                  automation:AutomationProperties.Name="Check for a launcher self-update" />
        </WrapPanel>
      </StackPanel>
    </controls:InAppDialog>

    <controls:InAppDialog x:Name="LauncherUpdateDialog"
                          Grid.RowSpan="2"
                          Style="{StaticResource InAppDialogStyle}"
                          DialogTitle="Install launcher update?"
                          automation:AutomationProperties.Name="Launcher self-update confirmation dialog">
      <StackPanel>
        <TextBlock x:Name="LauncherUpdateSummary"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,14,0,0"
                   FontWeight="SemiBold"
                   Text="Per-user launcher target" />
        <TextBlock x:Name="LauncherUpdateTarget"
                   Margin="0,4,0,0"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="The launcher will exit. A copied helper verifies and swaps the signed payload, starts the update, and restores the previous launcher if startup is not acknowledged. No elevation is requested."
                   TextWrapping="Wrap" />
        <Button Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource UtilityActionButtonStyle}"
                Click="ConfirmLauncherUpdateButton_Click"
                Content="_Install and restart"
                automation:AutomationProperties.Name="Install verified launcher update and restart" />
      </StackPanel>
    </controls:InAppDialog>

    <controls:InAppDialog x:Name="MaintenanceDialog"
                          Grid.RowSpan="2"
                          Style="{StaticResource InAppDialogStyle}"
                          DialogTitle="Confirm maintenance"
                          automation:AutomationProperties.Name="Community mod maintenance confirmation dialog">
      <StackPanel>
        <TextBlock x:Name="MaintenanceSummary"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,14,0,0"
                   FontWeight="SemiBold"
                   Text="Exact game target" />
        <TextBlock x:Name="MaintenanceTarget"
                   Margin="0,4,0,0"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
        <Button x:Name="ConfirmMaintenanceButton"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource UtilityActionButtonStyle}"
                Click="ConfirmMaintenanceButton_Click"
                Content="_Confirm"
                automation:AutomationProperties.Name="Confirm community mod maintenance" />
      </StackPanel>
    </controls:InAppDialog>

    <controls:InAppDialog x:Name="SettingsUnavailableDialog"
                          Grid.RowSpan="2"
                          Style="{StaticResource InAppDialogStyle}"
                          DialogTitle="Settings unavailable"
                          automation:AutomationProperties.Name="Settings unavailable dialog">
      <TextBlock x:Name="SettingsUnavailableMessage"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="The launcher could not load its configuration catalog." />
    </controls:InAppDialog>
  </Grid>
</Window>
