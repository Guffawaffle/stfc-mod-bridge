<Window x:Class="STFCCommunityMod.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:core="clr-namespace:STFCCommunityMod.Launcher.Core;assembly=STFCCommunityMod.Launcher.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="STFC Community Mod Launcher"
        Width="680"
        Height="590"
        MinWidth="560"
        MinHeight="500"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        automation:AutomationProperties.Name="STFC Community Mod Launcher">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Margin="24,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Text="STFC Community Mod" />
      <Button x:Name="ThemeToggleButton"
              Grid.Column="1"
              Style="{StaticResource QuietButtonStyle}"
              Click="ThemeToggleButton_Click"
              Content="Light"
              FontSize="13"
              ToolTip="Switch theme"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              automation:AutomationProperties.Name="Switch launcher theme" />
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal">
        <Button Style="{StaticResource CaptionButtonStyle}"
                Click="MinimizeButton_Click"
                Content="—"
                ToolTip="Minimize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Minimize launcher" />
        <Button x:Name="MaximizeRestoreButton"
                Style="{StaticResource CaptionButtonStyle}"
                Click="MaximizeRestoreButton_Click"
                Content="□"
                ToolTip="Maximize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Maximize launcher" />
        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                Click="CloseButton_Click"
                Content="×"
                FontSize="20"
                ToolTip="Close"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Close launcher" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1"
                Width="520"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center"
                 FontSize="32"
                 FontWeight="SemiBold"
                 Text="Make STFC yours."
                 TextAlignment="Center" />
      <TextBlock Margin="24,10,24,0"
                 HorizontalAlignment="Center"
                 FontSize="15"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Install, update, and configure the community mod in one place."
                 TextAlignment="Center" />

      <Border Margin="0,30,0,0"
              Padding="22,6"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="1" />
            <RowDefinition Height="76" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0"
                  Width="34"
                  Height="34"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  CornerRadius="17">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameFolderTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameFolderTone}"
                               Value="{x:Static core:LauncherHomeTone.Error}">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="{Binding GameFolderIcon}"
                       TextAlignment="Center"
                       automation:AutomationProperties.Name="{Binding GameFolderStatusAutomationName}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="Game folder" />

          <StackPanel Grid.Row="0"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding GameFolderStatus}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource QuietButtonStyle}"
                    Click="ChooseGameFolderButton_Click"
                    Content="{Binding GameFolderActionLabel}"
                    automation:AutomationProperties.Name="{Binding GameFolderActionAutomationName}" />
          </StackPanel>

          <Border Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Background="{DynamicResource BorderBrush}" />

          <Border Grid.Row="2"
                  Width="34"
                  Height="34"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  CornerRadius="17">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Bold"
                       Text="{Binding GameClientIcon}"
                       TextAlignment="Center"
                       automation:AutomationProperties.Name="{Binding GameClientStatusAutomationName}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Warning}">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="Game client" />
          <TextBlock Grid.Row="2"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     FontSize="15"
                     Text="{Binding GameClientStatus}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <Border Margin="0,14,0,0"
              Padding="12,9"
              Background="{DynamicResource SurfaceMutedBrush}"
              CornerRadius="8"
              Visibility="{Binding HasSelectionFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding SelectionFeedback}"
                   TextAlignment="Center"
                   automation:AutomationProperties.LiveSetting="Polite" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="2"
          Margin="34,0,34,26">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1"
              Margin="0,0,8,0"
              Style="{StaticResource QuietButtonStyle}"
              Click="AboutButton_Click"
              Content="_About"
              automation:AutomationProperties.Name="About STFC Community Mod Launcher" />
      <Button Grid.Column="2"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding RefreshCommand}"
              Content="_Refresh status"
              automation:AutomationProperties.Name="Refresh launcher status" />
    </Grid>
  </Grid>
</Window>
