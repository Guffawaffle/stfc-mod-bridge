<Window x:Class="STFCCommunityMod.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:STFCCommunityMod.Launcher.Controls"
        xmlns:core="clr-namespace:STFCCommunityMod.Launcher.Core;assembly=STFCCommunityMod.Launcher.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:STFCCommunityMod.Launcher.Views"
        Title="STFC Community Mod Launcher"
        Width="680"
        Height="590"
        MinWidth="560"
        MinHeight="500"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/stfc-community-mod.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        automation:AutomationProperties.Name="STFC Community Mod Launcher">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Margin="24,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Text="STFC Community Mod" />
      <Button x:Name="ThemeToggleButton"
              Grid.Column="1"
              Style="{StaticResource QuietButtonStyle}"
              Click="ThemeToggleButton_Click"
              Content="Light"
              FontSize="13"
              ToolTip="Switch theme"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              automation:AutomationProperties.Name="Switch launcher theme" />
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal">
        <Button Style="{StaticResource CaptionButtonStyle}"
                Click="MinimizeButton_Click"
                ToolTip="Minimize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Minimize launcher">
          <Viewbox Width="12"
                   Height="12">
            <Grid Width="12"
                  Height="12">
              <Path Data="M 1,6 L 11,6"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2"
                    StrokeStartLineCap="Square"
                    StrokeEndLineCap="Square" />
            </Grid>
          </Viewbox>
        </Button>
        <Button x:Name="MaximizeRestoreButton"
                Style="{StaticResource CaptionButtonStyle}"
                Click="MaximizeRestoreButton_Click"
                ToolTip="Maximize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Maximize launcher">
          <Viewbox Width="12"
                   Height="12">
            <Grid Width="12"
                  Height="12">
              <Path x:Name="MaximizeGlyph"
                    Data="M 1.5,1.5 L 10.5,1.5 L 10.5,10.5 L 1.5,10.5 Z"
                    Fill="Transparent"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2" />
              <Path x:Name="RestoreGlyph"
                    Data="M 3.5,1.5 L 10.5,1.5 L 10.5,8.5 M 8.5,3.5 L 1.5,3.5 L 1.5,10.5 L 8.5,10.5 Z"
                    Fill="Transparent"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2"
                    Visibility="Collapsed" />
            </Grid>
          </Viewbox>
        </Button>
        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                Click="CloseButton_Click"
                ToolTip="Close"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="Close launcher">
          <Viewbox Width="12"
                   Height="12">
            <Grid Width="12"
                  Height="12">
              <Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.2"
                    StrokeStartLineCap="Square"
                    StrokeEndLineCap="Square" />
            </Grid>
          </Viewbox>
        </Button>
      </StackPanel>
    </Grid>

    <StackPanel x:Name="HomeWorkspace"
                Grid.Row="1"
                Width="520"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center"
                 FontSize="32"
                 FontWeight="SemiBold"
                 Text="Make STFC yours."
                 TextAlignment="Center" />
      <TextBlock Margin="24,10,24,0"
                 HorizontalAlignment="Center"
                 FontSize="15"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Install, update, and configure the community mod in one place."
                 TextAlignment="Center" />

      <Border Margin="0,30,0,0"
              Padding="22,6"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="1" />
            <RowDefinition Height="76" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0"
                  Width="34"
                  Height="34"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  CornerRadius="17">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameFolderTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameFolderTone}"
                               Value="{x:Static core:LauncherHomeTone.Error}">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="{Binding GameFolderIcon}"
                       TextAlignment="Center"
                       automation:AutomationProperties.Name="{Binding GameFolderStatusAutomationName}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="Game folder" />

          <StackPanel Grid.Row="0"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <TextBlock Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding GameFolderStatus}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameFolderTone}"
                                 Value="{x:Static core:LauncherHomeTone.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource QuietButtonStyle}"
                    Click="ChooseGameFolderButton_Click"
                    Content="{Binding GameFolderActionLabel}"
                    automation:AutomationProperties.Name="{Binding GameFolderActionAutomationName}" />
          </StackPanel>

          <Border Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Background="{DynamicResource BorderBrush}" />

          <Border Grid.Row="2"
                  Width="34"
                  Height="34"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center"
                  CornerRadius="17">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Bold"
                       Text="{Binding GameClientIcon}"
                       TextAlignment="Center"
                       automation:AutomationProperties.Name="{Binding GameClientStatusAutomationName}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Success}">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding GameClientTone}"
                                 Value="{x:Static core:LauncherHomeTone.Warning}">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="Game client" />
          <TextBlock Grid.Row="2"
                     Grid.Column="2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontSize="15"
                     Text="{Binding GameClientStatus}"
                     TextAlignment="Right">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding GameClientTone}"
                               Value="{x:Static core:LauncherHomeTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <Border Margin="0,14,0,0"
              Padding="12,9"
              Background="{DynamicResource SurfaceMutedBrush}"
              CornerRadius="8"
              Visibility="{Binding HasSelectionFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding SelectionFeedback}"
                   TextAlignment="Center"
                   automation:AutomationProperties.LiveSetting="Polite" />
      </Border>
    </StackPanel>

    <views:SettingsView x:Name="SettingsWorkspace"
                        Grid.Row="1"
                        Margin="20,8,20,12"
                        Visibility="Collapsed" />

    <Grid x:Name="HomeActions"
          Grid.Row="2"
          Margin="34,0,34,26">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="WorkspaceNavigationButton"
              Grid.Column="0"
              HorizontalAlignment="Left"
              Style="{StaticResource UtilityActionButtonStyle}"
              Click="WorkspaceNavigationButton_Click"
              Content="_Settings"
              automation:AutomationProperties.Name="Open launcher settings" />
      <Button x:Name="AboutButton"
              Grid.Column="1"
              Margin="0,0,8,0"
              Style="{StaticResource UtilityActionButtonStyle}"
              Click="AboutButton_Click"
              Content="_About"
              automation:AutomationProperties.Name="About STFC Community Mod Launcher" />
      <Button x:Name="RefreshStatusButton"
              Grid.Column="2"
              Style="{StaticResource UtilityActionButtonStyle}"
              Command="{Binding RefreshCommand}"
              Content="_Refresh status"
              automation:AutomationProperties.Name="Refresh launcher status" />
    </Grid>

    <controls:InAppDialog x:Name="AboutDialog"
                          Grid.RowSpan="3"
                          Style="{StaticResource InAppDialogStyle}"
                          DialogTitle="About STFC Community Mod Launcher"
                          automation:AutomationProperties.Name="About STFC Community Mod Launcher dialog">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Width="64"
               Height="64"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="Assets/stfc-community-mod.png"
               Stretch="Uniform"
               automation:AutomationProperties.Name="STFC Community Mod icon" />
        <StackPanel Grid.Column="1"
                    Margin="18,0,0,0">
          <TextBlock FontSize="15"
                     FontWeight="SemiBold"
                     Text="Version 0.1.0" />
          <TextBlock Margin="0,12,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="A streamlined home for installing, updating, and configuring the STFC Community Mod." />
          <TextBlock Margin="0,12,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Community-built tools for Star Trek Fleet Command." />
        </StackPanel>
      </Grid>
    </controls:InAppDialog>

    <controls:InAppDialog x:Name="SettingsUnavailableDialog"
                          Grid.RowSpan="3"
                          Style="{StaticResource InAppDialogStyle}"
                          DialogTitle="Settings unavailable"
                          automation:AutomationProperties.Name="Settings unavailable dialog">
      <TextBlock x:Name="SettingsUnavailableMessage"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="The launcher could not load its configuration catalog." />
    </controls:InAppDialog>
  </Grid>
</Window>
