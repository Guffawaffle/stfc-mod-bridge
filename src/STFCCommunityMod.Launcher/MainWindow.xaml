<Window x:Class="STFCCommunityMod.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="STFC Community Mod Launcher"
        Width="1040"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        Background="{StaticResource SpaceBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        automation:AutomationProperties.Name="STFC Community Mod Launcher installation discovery preview">
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="132" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="0,0,18,0" IsHitTestVisible="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="96" />
        <RowDefinition Height="*" />
        <RowDefinition Height="76" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource AccentPurpleBrush}" CornerRadius="56,0,0,0" />
      <Border Grid.Row="1" Background="{StaticResource AccentOrangeBrush}" />
      <Border Grid.Row="2" Background="{StaticResource AccentBlueBrush}" CornerRadius="0,0,0,56" />
      <TextBlock Grid.Row="1"
                 Margin="18"
                 Foreground="#11131B"
                 FontSize="18"
                 FontWeight="Bold"
                 Text="LCARS&#x0a;WL-002"
                 VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource AccentPurpleBrush}"
              BorderThickness="0,0,0,4"
              Padding="24,18"
              CornerRadius="0,24,0,0">
        <StackPanel>
          <TextBlock FontSize="13"
                     FontWeight="Bold"
                     Foreground="{StaticResource AccentPurpleBrush}"
                     Text="WINDOWS LAUNCHER / INSTALLATION DISCOVERY" />
          <TextBlock Margin="0,5,0,0"
                     FontSize="30"
                     FontWeight="Bold"
                     Text="STFC COMMUNITY MOD" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1"
                    Margin="0,18"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource AccentOrangeBrush}"
                  BorderThickness="4,0,0,0"
                  Padding="22"
                  CornerRadius="0,12,12,0">
            <StackPanel>
              <TextBlock FontSize="13"
                         FontWeight="Bold"
                         Foreground="{StaticResource AccentOrangeBrush}"
                         Text="CURRENT STATE" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="25"
                         FontWeight="Bold"
                         Text="{Binding StatusTitle}"
                         automation:AutomationProperties.LiveSetting="Polite" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="16"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="{Binding StatusDetail}" />
            </StackPanel>
          </Border>

          <UniformGrid Margin="0,16,0,0" Columns="2">
            <Border Margin="0,0,8,0"
                    Padding="18"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="12">
              <StackPanel>
                <TextBlock FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlueBrush}"
                           Text="PROCESS SAFETY" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="{Binding ProcessStatus}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Mutating operations will use this UI-independent process boundary." />
              </StackPanel>
            </Border>
            <Border Margin="8,0,0,0"
                    Padding="18"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="12">
              <StackPanel>
                <TextBlock FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlueBrush}"
                           Text="INSTALL OWNERSHIP" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding ProgramDirectory}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Per-user, unpackaged, and never silently elevated." />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Margin="0,16,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBrush}"
                  CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="13"
                         FontWeight="Bold"
                         Foreground="{StaticResource AccentPurpleBrush}"
                         Text="CONFIRMED GAME FOLDER" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Text="{Binding SelectedGameDirectory}" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="{Binding SelectionFeedback}"
                         automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBrush}"
                  CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="13"
                         FontWeight="Bold"
                         Foreground="{StaticResource AccentPurpleBrush}"
                         Text="BOUNDED CANDIDATES" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="15"
                         Text="{Binding DiscoverySummary}" />
              <ItemsControl Margin="0,8,0,0"
                            ItemsSource="{Binding CandidateSummaries}"
                            automation:AutomationProperties.Name="STFC installation candidates">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBrush}"
                  CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="13"
                         FontWeight="Bold"
                         Foreground="{StaticResource AccentBlueBrush}"
                         Text="COMPOSABLE HEALTH" />
              <ItemsControl Margin="0,8,0,0"
                            ItemsSource="{Binding HealthSummaries}"
                            automation:AutomationProperties.Name="Launcher health dimensions">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,3,0,0" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="0,8,0,0"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="Discovery and selection are read-only with respect to the game installation." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <DockPanel Grid.Row="2" LastChildFill="False">
        <Button Command="{Binding RefreshCommand}"
                Content="_Refresh discovery"
                automation:AutomationProperties.Name="Refresh installation discovery" />
        <Button Background="{StaticResource AccentPurpleBrush}"
                Click="ChooseGameFolderButton_Click"
                Content="_Choose game folder"
                automation:AutomationProperties.Name="Choose STFC game folder" />
        <Button Background="{StaticResource AccentBlueBrush}"
                Click="CloseButton_Click"
                Content="E_xit"
                automation:AutomationProperties.Name="Exit launcher" />
        <TextBlock Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Keyboard accessible • Reduced motion • Per-monitor DPI" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
