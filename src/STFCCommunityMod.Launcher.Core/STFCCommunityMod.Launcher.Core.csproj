<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>STFCCommunityMod.Launcher.Core</RootNamespace>
    <AssemblyName>STFCCommunityMod.Launcher.Core</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\STFCModBridge.ReleaseVerifier\trusted-root.public-good.v1.json"
      LogicalName="STFCCommunityMod.Launcher.Core.ReleaseSelectionTrustedRoot.v1.json" />
  </ItemGroup>
</Project>
