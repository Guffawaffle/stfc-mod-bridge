{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STFC Mod Bridge",
  "version": "0.1.0",
  "identifier": "com.guffawaffle.stfcmodbridge.next",
  "build": {
    "beforeDevCommand": "node ../../scripts/next/pnpm.mjs --dir ui dev",
    "beforeBuildCommand": "node ../../scripts/next/pnpm.mjs --dir ui build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "STFC Mod Bridge", "width": 1320, "height": 860, "minWidth": 840, "minHeight": 600}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"}
  },
  "bundle": {
    "active": false,
    "icon": ["../../../assets/stfc-mod-bridge.png", "../../../src/STFCCommunityMod.Launcher/Assets/stfc-mod-bridge.ico"]
  }
}
