{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "checkJs": true, "strict": true, "isolatedModules": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "scenarios/**/*.ts", "scenarios/**/*.svelte", "vite.config.ts", "svelte.config.js"]
}
